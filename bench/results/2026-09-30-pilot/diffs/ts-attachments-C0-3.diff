   }
   return `${Number.isInteger(size) ? size : size.toFixed(1)} ${UNITS[unit]}`;
 }
+
+const TIME_UNITS: [number, string, string][] = [
+  [365 * 24 * 3600, "año", "años"],
+  [30 * 24 * 3600, "mes", "meses"],
+  [24 * 3600, "día", "días"],
+  [3600, "hora", "horas"],
+  [60, "minuto", "minutos"],
+];
+
+export function formatAgo(date: Date, now: Date = new Date()): string {
+  const seconds = Math.max(
+    0,
+    Math.floor((now.getTime() - date.getTime()) / 1000),
+  );
+  for (const [size, singular, plural] of TIME_UNITS) {
+    if (seconds >= size) {
+      const n = Math.floor(seconds / size);
+      return `hace ${n} ${n === 1 ? singular : plural}`;
+    }
+  }
+  return "hace unos segundos";
+}
