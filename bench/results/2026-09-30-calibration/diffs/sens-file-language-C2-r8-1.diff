+// A file without an extension or a known name is read for its shebang.
+function useLanguageTitle(file: DiffFile) {
+  const root = useStore(project, (s) => s.work);
+  const [head, setHead] = useState("");
+  const byPath = languageTitleOf(file.path);
+  const reads = !byPath && file.state !== "D" && !file.binary && !stem(file.path).includes(".");
+  useEffect(() => {
+    setHead("");
+    if (!reads) return;
+    let live = true;
+    commands.openFile(root, file.path).then(
+      (opened) => live && opened.kind === "text" && setHead(opened.text.slice(0, 200)),
+      () => {},
+    );
+    return () => {
+      live = false;
+    };
+  }, [reads, root, file.path, file.plus, file.minus]);
+  return byPath ?? (head ? languageTitleOf(file.path, head) : null);
+}
