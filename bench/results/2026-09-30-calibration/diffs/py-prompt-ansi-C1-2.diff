+@pytest.mark.parametrize("color", [None, False])
+def test_prompt_and_confirm_strip_ansi(runner, color):
+    @click.command()
+    def cmd():
+        click.prompt(click.style("Name", fg="red"))
+        click.confirm(click.style("Sure", fg="green"))
+
+    result = runner.invoke(cmd, input="a\ny\n", color=color)
+    assert "\x1b" not in result.output
+    assert "Name: " in result.output
+    assert "Sure [y/N]: " in result.output
+
