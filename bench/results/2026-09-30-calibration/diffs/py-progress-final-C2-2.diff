+def test_progress_bar_update_min_steps_flushes_remainder(runner, monkeypatch):
+    monkeypatch.setattr(click._termui_impl, "isatty", lambda _: True)
+
+    with _create_progress(length=20, update_min_steps=7) as bar:
+        for _ in range(20):
+            bar.update(1)
+        assert bar.pos == 14
+
+    assert bar.pos == 20
+
+    bar = _create_progress(length=20, update_min_steps=7)
+    with bar:
+        for _ in bar:
+            pass
+
+    assert bar.pos == 20
+
+
