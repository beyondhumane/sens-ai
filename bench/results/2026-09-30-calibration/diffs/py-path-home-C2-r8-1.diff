+def test_path_resolve_expands_home(tmp_path, monkeypatch):
+    (tmp_path / "notes.txt").write_text("")
+    monkeypatch.setenv("HOME", os.fspath(tmp_path))
+    monkeypatch.setenv("USERPROFILE", os.fspath(tmp_path))
+
+    path_type = click.Path(exists=True, resolve_path=True)
+    rv = path_type.convert("~/notes.txt", None, None)
+    assert rv == os.path.realpath(tmp_path / "notes.txt")
+
