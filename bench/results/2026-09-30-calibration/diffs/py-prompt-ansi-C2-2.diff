+@pytest.mark.parametrize("color", [False, True])
+def test_prompt_strips_ansi(runner, color):
+    @click.command()
+    def cli():
+        click.prompt(click.style("Name", fg="red"))
+        click.confirm(click.style("Sure", fg="red"))
+
+    result = runner.invoke(cli, input="a\ny\n", color=color)
+    assert result.exception is None
+    assert ("\x1b[31m" in result.output) is color
+
