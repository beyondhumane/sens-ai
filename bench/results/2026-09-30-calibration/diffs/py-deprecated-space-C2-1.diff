+def test_deprecated_without_help_has_no_leading_space(runner):
+    @click.command(help="", deprecated=True)
+    @click.option("--foo", help="", deprecated=True)
+    def cmd(foo):
+        pass
+
+    result = runner.invoke(cmd, ["--help"])
