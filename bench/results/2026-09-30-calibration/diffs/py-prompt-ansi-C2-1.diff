     assert "leaky" not in result.stdout
     assert "leaky" not in result.stderr
+
+
+@pytest.mark.parametrize("color", [False, True])
+def test_prompts_strip_ansi_when_not_a_tty(runner, color):
+    @click.command()
+    def cli():
+        click.prompt(click.style("Name", fg="red"))
+        click.confirm(click.style("Sure", bold=True))
+
+    result = runner.invoke(cli, input="a\ny\n", color=color)
+    assert ("\x1b[" in result.output) is color
