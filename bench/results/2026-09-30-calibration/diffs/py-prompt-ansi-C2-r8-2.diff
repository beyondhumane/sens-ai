@@ -83,7 +84,12 @@ def hidden_prompt_func(prompt: str) -> str:
 def _readline_prompt(func: t.Callable[[str], str], text: str, err: bool) -> str:
     """Call a prompt function, passing the full prompt on non-Windows so
     readline can handle line editing and cursor positioning correctly.
+    ANSI codes are stripped the same way :func:`echo` does.
     """
+    if _compat.should_strip_ansi(
+        sys.stderr if err else sys.stdout, resolve_color_default()
+    ):
+        text = strip_ansi(text)
     if err:
         with redirect_stdout(sys.stderr):
             return func(text)
