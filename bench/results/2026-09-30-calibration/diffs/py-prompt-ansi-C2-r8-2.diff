+
+
+@pytest.mark.parametrize("color", [False, True])
+def test_prompt_and_confirm_strip_ansi(runner, color):
+    @click.command()
+    def cli():
+        click.prompt(click.style("Name", fg="red"))
+        click.confirm(click.style("Sure", fg="green"))
+
+    result = runner.invoke(cli, input="x\ny\n", color=color)
+    assert ("\x1b[" in result.output) is color
