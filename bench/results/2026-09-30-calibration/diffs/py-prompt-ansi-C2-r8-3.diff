+@pytest.mark.parametrize("color", [None, False, True])
+@pytest.mark.parametrize("func", [click.prompt, click.confirm])
+def test_prompt_strips_ansi_like_echo(runner, func, color):
+    @click.command()
+    @click.pass_context
+    def cmd(ctx):
+        ctx.color = color
+        func(click.style("Question", fg="red"))
+
+    result = runner.invoke(cmd, input="y\n")
+    assert ("\x1b[" in result.output) is bool(color)
+
