+def test_choice_option_suggests_close_matches(runner):
+    @click.command()
+    @click.option("--method", type=click.Choice(["foo", "bar", "baz"]))
+    def cli(method):
+        click.echo(method)
+
+    result = runner.invoke(cli, ["--method=fo"])
+    assert result.exit_code == 2
+    assert "Did you mean 'foo'?" in result.output
+
+    result = runner.invoke(cli, ["--method=meh"])
+    assert "Did you mean" not in result.output
+
+
 def test_choice_argument(runner):
