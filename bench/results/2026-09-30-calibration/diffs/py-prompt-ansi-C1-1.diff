+@pytest.mark.parametrize("color", [False, True])
+@pytest.mark.parametrize("func", [click.prompt, click.confirm])
+def test_prompt_strips_ansi_like_echo(runner, color, func):
+    @click.command()
+    def cmd():
+        func(click.style("Question", fg="red"))
+
+    result = runner.invoke(cmd, input="y\n", color=color)
+    assert ("\x1b[31m" in result.output) is color
+    assert "Question" in result.output
+
