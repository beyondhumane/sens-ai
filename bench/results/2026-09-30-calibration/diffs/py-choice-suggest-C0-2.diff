@@ -330,3 +330,14 @@ def test_param_type_subclass_omitting_input_parameter():
     doubling = DoublingType()
     assert doubling("21") == 42
     assert doubling(None) is None
+
+
+def test_choice_suggests_close_matches():
+    choice = click.Choice(["apple", "banana", "cherry"])
+    with pytest.raises(click.BadParameter) as exc_info:
+        choice.convert("appel", None, None)
+    assert "Did you mean 'apple'?" in exc_info.value.message
+
+    with pytest.raises(click.BadParameter) as exc_info:
+        choice.convert("zzz", None, None)
+    assert "Did you mean" not in exc_info.value.message
