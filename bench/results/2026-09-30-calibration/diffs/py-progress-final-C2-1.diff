+def test_progress_bar_update_min_steps_flushes_on_exit(runner, monkeypatch):
+    monkeypatch.setattr(click._termui_impl, "isatty", lambda _: True)
+    with click.progressbar(length=20, update_min_steps=7, show_pos=True) as bar:
+        for _ in range(20):
+            bar.update(1)
+        assert bar.pos == 14
+    assert bar.pos == 20
+    assert bar._completed_intervals == 0
+
+    with click.progressbar(range(20), update_min_steps=7, show_pos=True) as bar:
+        for _ in bar:
+            pass
+    assert bar.pos == 20
+
