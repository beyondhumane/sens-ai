+@pytest.mark.parametrize("color", [False, True])
+def test_prompt_and_confirm_strip_ansi_like_echo(runner, color):
+    styled = click.style("Name", fg="red")
+
+    @click.command()
+    def cmd():
+        click.prompt(styled)
+        click.confirm(styled)
+
+    result = runner.invoke(cmd, input="a\ny\n", color=color)
+    assert ("\x1b[" in result.output) is color
+
