+def test_choice_invalid_choice_suggests_close_matches():
+    choice = click.Choice(["apple", "banana"])
+    message = choice.get_invalid_choice_message("aple", ctx=None)
+    assert message.endswith("Did you mean 'apple'?")
+
+    case_insensitive = click.Choice(["Apple"], case_sensitive=False)
+    message = case_insensitive.get_invalid_choice_message("APLE", ctx=None)
+    assert "Did you mean 'apple'?" in message
+
