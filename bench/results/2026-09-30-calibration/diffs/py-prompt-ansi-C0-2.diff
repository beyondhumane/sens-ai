     assert "leaky" not in result.stdout
     assert "leaky" not in result.stderr
+
+
+@pytest.mark.parametrize("color", [None, False])
+def test_prompt_strips_ansi_when_not_tty(runner, color):
+    @click.command()
+    def cli():
+        click.confirm(click.style("Sure", fg="red"))
+        click.prompt(click.style("Name", fg="green"))
+
+    result = runner.invoke(cli, input="y\nbob\n", color=color)
+    assert "\x1b" not in result.output
+    assert "Sure" in result.output
+    assert "Name" in result.output
