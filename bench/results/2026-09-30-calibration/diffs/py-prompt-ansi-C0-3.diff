+
+
+@pytest.mark.parametrize("color", [False, True])
+@pytest.mark.parametrize("func", [click.prompt, click.confirm])
+def test_prompt_strips_ansi_like_echo(runner, func, color):
+    @click.command()
+    def cli():
+        func(click.style("Go", fg="red"))
+
+    result = runner.invoke(cli, input="y\n", color=color)
+    assert ("\x1b[" in result.output) is color
