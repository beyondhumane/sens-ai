--- a/src/cli.ts
+++ b/src/cli.ts
@@ -152,6 +152,21 @@ const commands: Record<string, Command> = {
     );
     return found.length === 0 ? "Sin resultados" : found.map(line).join("\n");
   },
+  duplicados: (args, io) => {
+    const groups = new Map<string, { first: Expense; count: number }>();
+    for (const expense of load(args[0], io)) {
+      const key = `${expense.date}|${expense.cents}|${fold(expense.description).trim().replace(/\s+/g, " ")}`;
+      const group = groups.get(key);
+      if (group) group.count++;
+      else groups.set(key, { first: expense, count: 1 });
+    }
+    const repeated = [...groups.values()].filter((group) => group.count > 1);
+    return repeated.length === 0
+      ? "Sin duplicados"
+      : repeated
+          .map(({ first, count }) => `${count} veces: ${formatDate(first.date)}  ${formatMoney(first.cents)}  ${first.description}`)
+          .join("\n");
+  },
   categorias: (args, io) =>
     categoryTotals(load(args[0], io))
       .map(([category, cents]) => `${category}: ${formatMoney(cents)}`)
