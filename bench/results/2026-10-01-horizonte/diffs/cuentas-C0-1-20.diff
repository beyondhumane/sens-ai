+describe("duplicados", () => {
+  it("reports groups with same date, amount and description ignoring case, accents and extra spaces", () => {
+    const csv = `fecha,importe,categoria,descripcion
+2026-03-09,8.75,Ocio,Café con Ana
+2026-03-09,8.75,Comida,  cafe   CON ana
+2026-03-09,8.75,Ocio,Café con Ana
+2026-03-10,8.75,Ocio,Café con Ana
+2026-03-09,9.00,Ocio,Café con Ana
+`;
+    const io = memoryIo({ "gastos.csv": csv });
+    expect(shown(run(["duplicados", "gastos.csv"], io).output)).toBe("3 veces: 09/03/2026  8,75 €  Café con Ana");
+    expect(run(["duplicados", "gastos.csv"], memoryIo({ "gastos.csv": GASTOS })).output).toBe("Sin duplicados");
+  });
+});
