 });
+
+describe("añadir", () => {
+  it("appends a valid expense", () => {
+    const io = memoryIo({ "gastos.csv": GASTOS });
+    const ran = run(["añadir", "gastos.csv", "2026-03-19", "4.2", "Comida", "Churros", "con", "chocolate"], io);
+    expect(ran.code).toBe(0);
+    expect(shown(ran.output)).toBe("Añadido: 19/03/2026  Comida  4,20 €  Churros con chocolate");
+    expect(io.files["gastos.csv"]).toBe(`${GASTOS}2026-03-19,4.20,Comida,Churros con chocolate\n`);
+  });
+
+  it("adds the missing final newline", () => {
+    const io = memoryIo({ "gastos.csv": GASTOS.trimEnd() });
+    run(["añadir", "gastos.csv", "2026-03-19", "4.20", "Comida", "Churros"], io);
+    expect(io.files["gastos.csv"]).toBe(`${GASTOS}2026-03-19,4.20,Comida,Churros\n`);
+  });
+
+  it("rejects bad input without touching the file", () => {
+    const io = memoryIo({ "gastos.csv": GASTOS });
+    const bad = (...a: string[]) => run(["añadir", "gastos.csv", ...a], io);
+    expect(bad("2026-02-30", "4.20", "Comida", "x")).toEqual({ code: 1, output: "Fecha no válida: 2026-02-30" });
+    expect(bad("19/03/2026", "4.20", "Comida", "x").output).toBe("Fecha no válida: 19/03/2026");
+    expect(bad("2026-03-19", "-3", "Comida", "x")).toEqual({ code: 1, output: "Importe no válido: -3" });
+    expect(bad("2026-03-19", "0", "Comida", "x").code).toBe(1);
+    expect(bad("2026-03-19", "1.234", "Comida", "x").code).toBe(1);
+    expect(bad("2026-03-19", "1,5", "Comida", "x").code).toBe(1);
+    expect(bad("2026-03-19", "4.20", "Comida").code).toBe(1);
+    expect(io.files["gastos.csv"]).toBe(GASTOS);
+  });
+});
