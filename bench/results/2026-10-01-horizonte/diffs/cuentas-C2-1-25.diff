+++ b/tests/resumen.test.ts
@@ -0,0 +1,33 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const header = "fecha,importe,categoria,descripcion";
+
+it("summarizes count, date range, total and the biggest expense (first one on ties)", () => {
+  const csv = [
+    header,
+    "2026-01-15,120,coche,Seguro del coche",
+    "2026-02-28,292.30,casa,Alquiler",
+    "2026-01-03,120,ocio,Otro igual",
+  ].join("\n");
+  const result = run(["resumen", "g.csv"], memoryIo({ "g.csv": csv }));
+  expect(result.code).toBe(0);
+  expect(result.output).toBe(
+    [
+      "Gastos: 3",
+      "Desde 03/01/2026 hasta 28/02/2026",
+      "Total: 532,30 €",
+      "Mayor: 292,30 € en Alquiler (28/02/2026)",
+    ].join("\n"),
+  );
+});
+
+it("picks the first of several equal biggest expenses", () => {
+  const csv = [header, "2026-01-15,120,coche,Seguro del coche", "2026-01-03,120,ocio,Otro igual"].join("\n");
+  expect(run(["resumen", "g.csv"], memoryIo({ "g.csv": csv })).output).toContain("Mayor: 120,00 € en Seguro del coche (15/01/2026)");
+});
+
+it("says so when there are no expenses", () => {
+  expect(run(["resumen", "g.csv"], memoryIo({ "g.csv": header })).output).toBe("Sin gastos");
+});
