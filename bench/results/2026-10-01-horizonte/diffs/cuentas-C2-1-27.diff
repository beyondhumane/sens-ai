+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const files = {
+  "g.csv": [
+    "fecha,importe,categoria,descripcion",
+    "2026-02-01,40.00,Comida,Pan",
+    "2026-02-02,90.00,Ocio,Cine",
+    "2026-02-03,5.00,Casa,Luz",
+    "2026-03-01,44.65,Comida,Cena",
+    "2026-03-02,60.00,Ocio,Teatro",
+    "2026-03-03,5.00,Casa,Luz",
+    "2026-03-04,12.00,Viajes,Tren",
+  ].join("\n"),
+};
+
+const nbsp = (text: string) => text.replace(/ /g, " ");
+
+it("compares each category between two months, sorted alphabetically, with signed difference", () => {
+  const ran = run(["comparar", "g.csv", "2026-02", "2026-03"], memoryIo(files));
+  expect(ran.code).toBe(0);
+  expect(nbsp(ran.output)).toBe(
+    [
+      "Casa: 5,00 € → 5,00 € (+0,00 €)",
+      "Comida: 40,00 € → 44,65 € (+4,65 €)",
+      "Ocio: 90,00 € → 60,00 € (-30,00 €)",
+      "Viajes: 0,00 € → 12,00 € (+12,00 €)",
+    ].join("\n"),
+  );
+});
+
+it("rejects an invalid month or missing arguments", () => {
+  expect(run(["comparar", "g.csv", "2026-02", "2026-13"], memoryIo(files)).code).toBe(1);
+  expect(run(["comparar", "g.csv", "2026-02"], memoryIo(files)).code).toBe(1);
+});
