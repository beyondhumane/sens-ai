+++ b/tests/avisos.test.ts
@@ -0,0 +1,29 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const files = {
+  "g.csv": [
+    "fecha,importe,categoria,descripcion",
+    "2026-03-01,44.65,Comida,Pan",
+    "2026-03-02,60.00,Ocio,Cine",
+    "2026-03-03,5.00,Casa,Luz",
+    "2026-03-04,70.00,Comida,Cena",
+    "2026-04-04,500.00,Casa,Alquiler",
+  ].join("\n"),
+  "p.csv": "categoria,importe\ncomida,100.00\nOCIO,55.00\nCasa,50.00\n",
+};
+
+it("lists over-budget categories of the month, biggest excess first, with the expenses' name", () => {
+  const ran = run(["avisos", "g.csv", "p.csv", "--mes", "2026-03"], memoryIo(files));
+  expect(ran.code).toBe(0);
+  expect(ran.output.replace(/ /g, " ")).toBe("Comida: te pasas 14,65 €\nOcio: te pasas 5,00 €");
+});
+
+it("says all is fine when nothing is exceeded", () => {
+  expect(run(["avisos", "g.csv", "p.csv", "--mes", "2026-02"], memoryIo(files)).output).toBe("Todo en orden");
+});
+
+it("requires the month", () => {
+  expect(run(["avisos", "g.csv", "p.csv"], memoryIo(files)).code).toBe(1);
+});
