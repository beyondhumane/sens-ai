 const commands: Record<string, Command> = {
-  lista: (args, io) => load(args[0], io).map(line).join("\n"),
+  lista: (args, io) => {
+    const { date: from, rest: afterFrom } = takeDate(args, "--desde");
+    const { date: to, rest } = takeDate(afterFrom, "--hasta");
+    return load(rest[0], io)
+      .filter((expense) => (from === undefined || expense.date >= from) && (to === undefined || expense.date <= to))
+      .map(line)
+      .join("\n");
+  },
