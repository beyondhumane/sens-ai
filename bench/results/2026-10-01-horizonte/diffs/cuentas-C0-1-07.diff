+function takeDate(args: string[], name: string): { date: string | undefined; rest: string[] } {
+  const flag = args.indexOf(name);
+  if (flag === -1) return { date: undefined, rest: args };
+  const date = args[flag + 1];
+  if (date === undefined || !isRealDate(date)) throw new Error(`Fecha no válida: ${date ?? ""}`.trim());
+  return { date, rest: args.filter((_, i) => i !== flag && i !== flag + 1) };
+}
