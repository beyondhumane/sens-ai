index 0000000..9ac0d08
--- /dev/null
+++ b/tests/buscar.test.ts
@@ -0,0 +1,16 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const csv = ["fecha,importe,categoria,descripcion", "2026-03-01,3.5,ocio,Café con Ana", "2026-03-02,10,casa,Luz"].join("\n");
+
+it("finds expenses ignoring case and accents, with the lista lines", () => {
+  const io = memoryIo({ "g.csv": csv });
+  const found = run(["buscar", "g.csv", "CAFE"], io);
+  expect(found.code).toBe(0);
+  expect(found.output).toBe(run(["lista", "g.csv"], memoryIo({ "g.csv": csv.split("\n").slice(0, 2).join("\n") })).output);
+});
+
+it("says so when nothing matches", () => {
+  expect(run(["buscar", "g.csv", "zzz"], memoryIo({ "g.csv": csv })).output).toBe("Sin resultados");
+});
