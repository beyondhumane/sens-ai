+const BANK_HEADER = "Fecha;Concepto;Importe";
+
+function parseBankDate(text: string): string | undefined {
+  const match = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(text);
+  if (!match) return undefined;
+  const iso = `${match[3]}-${match[2]}-${match[1]}`;
+  return isRealDate(iso) ? iso : undefined;
+}
+
+function parseBankAmount(text: string): number | undefined {
+  const match = /^([+-]?)(\d+|\d{1,3}(?:\.\d{3})+)(?:,(\d{1,2}))?$/.exec(text);
+  if (!match) return undefined;
+  const cents = Number(match[2].replace(/\./g, "")) * 100 + Number((match[3] ?? "").padEnd(2, "0"));
+  return match[1] === "-" ? -cents : cents;
+}
