+
+describe("importar", () => {
+  const BANCO = `Fecha;Concepto;Importe
+09/03/2026;Bar Paco;-8,75
+10/03/2026;Nómina;1.850,00
+11/03/2026;Cena, con amigos;-1.234,5
+`;
+
+  it("appends only the expenses, as positive amounts without category", () => {
+    const io = memoryIo({ "b.csv": BANCO, "g.csv": GASTOS });
+    expect(run(["importar", "b.csv", "g.csv"], io)).toEqual({ code: 0, output: "Importados 2 gastos" });
+    expect(io.files["g.csv"]).toBe(`${GASTOS}2026-03-09,8.75,Sin categoría,Bar Paco\n2026-03-11,1234.50,Sin categoría,"Cena, con amigos"\n`);
+  });
+
+  it("imports nothing and names the bad line", () => {
+    const bad = (line: string) => {
+      const io = memoryIo({ "b.csv": `Fecha;Concepto;Importe\n09/03/2026;Bar;-1,00\n${line}\n`, "g.csv": GASTOS });
+      const ran = run(["importar", "b.csv", "g.csv"], io);
+      expect(io.files["g.csv"]).toBe(GASTOS);
+      return ran;
+    };
+    expect(bad("30/02/2026;X;-1,00")).toEqual({ code: 1, output: "Línea 3 del banco no válida" });
+    expect(bad("10/03/2026;X;abc").code).toBe(1);
+    expect(bad("10/03/2026;X").code).toBe(1);
+    expect(bad("10/03/2026;;-1,00").code).toBe(1);
+  });
+
+  it("handles CRLF and files without expenses", () => {
+    const io = memoryIo({ "b.csv": "Fecha;Concepto;Importe\r\n10/03/2026;Nómina;5,00\r\n", "g.csv": GASTOS });
+    expect(run(["importar", "b.csv", "g.csv"], io).output).toBe("Importados 0 gastos");
+    expect(io.files["g.csv"]).toBe(GASTOS);
