   });
 });
+
+describe("renombrar", () => {
+  const CSV = `fecha,importe,categoria,descripcion
+2026-03-01,12.50,Comida,"Pan, y fruta"
+2026-03-02,2.00,Ocio,Cine
+2026-03-03,3.00,COMIDA,Café
+`;
+
+  it("renames every match ignoring case and accents", () => {
+    const io = memoryIo({ "g.csv": CSV });
+    expect(run(["renombrar", "g.csv", "cómida", "Alimentación"], io)).toEqual({ code: 0, output: "Renombrados 2 gastos" });
+    expect(io.files["g.csv"]).toBe(
+      'fecha,importe,categoria,descripcion\n2026-03-01,12.50,Alimentación,"Pan, y fruta"\n2026-03-02,2.00,Ocio,Cine\n2026-03-03,3.00,Alimentación,Café\n',
+    );
+  });
+
+  it("leaves the file alone when nothing matches or input is invalid", () => {
+    const io = memoryIo({ "g.csv": CSV });
+    expect(run(["renombrar", "g.csv", "Viajes", "X"], io).output).toBe("Renombrados 0 gastos");
+    expect(run(["renombrar", "g.csv", "Ocio", "a,b"], io).code).toBe(1);
+    expect(io.files["g.csv"]).toBe(CSV);
+  });
+});
