+
+describe("comillas CSV", () => {
+  const QUOTED = `fecha,importe,categoria,descripcion
+2026-03-05,18.00,Ocio,"Cena, con amigos"
+2026-03-06,3.00,Ocio,"Dijo ""hola"""
+2026-03-07,1.00,Ocio,"Con ""comas"", y más"
+`;
+
+  it("reads quoted descriptions in every command", () => {
+    const io = memoryIo({ "g.csv": QUOTED });
+    expect(shown(run(["lista", "g.csv"], io).output).split("\n").map((l) => l.split("  ")[3])).toEqual([
+      "Cena, con amigos",
+      'Dijo "hola"',
+      'Con "comas", y más',
+    ]);
+    expect(shown(run(["buscar", "g.csv", "hola"], io).output)).toBe('06/03/2026  Ocio  3,00 €  Dijo "hola"');
+    expect(shown(run(["total", "g.csv"], io).output)).toBe("Total: 22,00 €");
+    expect(shown(run(["categorias", "g.csv"], io).output)).toBe("Ocio: 22,00 €");
+    expect(shown(run(["informe", "g.csv", "--mes", "2026-03"], io).output)).toContain("Total: 22,00 €");
+  });
+
+  it("reads CRLF files", () => {
+    const io = memoryIo({ "g.csv": QUOTED.replace(/\n/g, "\r\n") });
+    expect(run(["lista", "g.csv"], io).code).toBe(0);
+  });
+
+  it("writes descriptions with commas or quotes quoted, and reads them back", () => {
+    const io = memoryIo({ "g.csv": GASTOS });
+    run(["añadir", "g.csv", "2026-03-10", "5", "Ocio", "Cena,", "con", 'amigos'], io);
+    run(["añadir", "g.csv", "2026-03-11", "5", "Ocio", 'Dijo "hola"'], io);
+    run(["añadir", "g.csv", "2026-03-12", "5", "Ocio", "Sin", "nada"], io);
+    expect(io.files["g.csv"]).toBe(
+      `${GASTOS}2026-03-10,5.00,Ocio,"Cena, con amigos"\n2026-03-11,5.00,Ocio,"Dijo ""hola"""\n2026-03-12,5.00,Ocio,Sin nada\n`,
+    );
+    expect(shown(run(["lista", "g.csv"], io).output).split("\n").slice(2).map((l) => l.split("  ")[3])).toEqual([
+      "Cena, con amigos",
+      'Dijo "hola"',
+      "Sin nada",
+    ]);
+  });
+});
