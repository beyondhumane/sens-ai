diff --git a/tests/media.test.ts b/tests/media.test.ts
new file mode 100644
index 0000000..ee3f98b
--- /dev/null
+++ b/tests/media.test.ts
@@ -0,0 +1,31 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const shown = (output: string) => output.replace(/ /g, " ");
+
+const csv = [
+  "fecha,importe,categoria,descripcion",
+  "2026-02-10,56,casa,Febrero",
+  "2026-03-02,100,casa,Luz",
+  "2026-03-04,45,ocio,Cine",
+  "2026-04-01,500,casa,Otro mes",
+].join("\n");
+
+it("averages the month total over every day of the month, rounded to the cent", () => {
+  const result = run(["media", "g.csv", "--mes", "2026-03"], memoryIo({ "g.csv": csv }));
+  expect(result.code).toBe(0);
+  expect(shown(result.output)).toBe("Media diaria en marzo de 2026: 4,68 €");
+});
+
+it("counts the real length of the month", () => {
+  const result = run(["media", "g.csv", "--mes", "2026-02"], memoryIo({ "g.csv": csv }));
+  expect(shown(result.output)).toBe("Media diaria en febrero de 2026: 2,00 €");
+});
+
+it("requires the month", () => {
+  expect(run(["media", "g.csv"], memoryIo({ "g.csv": csv }))).toEqual({
+    code: 1,
+    output: "Uso: media <fichero> --mes AAAA-MM",
+  });
+});
