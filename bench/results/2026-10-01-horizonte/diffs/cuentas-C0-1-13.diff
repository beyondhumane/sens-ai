+describe("semana", () => {
+  const csv = `fecha,importe,categoria,descripcion
+2026-02-27,9.99,A,Viernes anterior
+2026-03-02,45.20,A,Lunes
+2026-03-02,0.00,A,Otro lunes
+2026-03-04,3.10,A,Miercoles
+2026-03-08,1.00,A,Domingo
+2026-03-09,7.00,A,Lunes siguiente
+`;
+  const io = memoryIo({ "g.csv": csv });
+
+  it("lists each day with expenses, Monday to Sunday, and the total", () => {
+    const expected = "Lunes 02/03/2026: 45,20 €\nMiércoles 04/03/2026: 3,10 €\nDomingo 08/03/2026: 1,00 €\nTotal: 49,30 €";
+    expect(shown(run(["semana", "g.csv", "2026-03-02"], io).output)).toBe(expected);
+    expect(shown(run(["semana", "g.csv", "2026-03-08"], io).output)).toBe(expected);
+    expect(shown(run(["semana", "g.csv", "2026-03-05"], io).output)).toBe(expected);
+  });
+
+  it("shows only the total for an empty week and rejects bad dates", () => {
+    expect(shown(run(["semana", "g.csv", "2026-04-01"], io).output)).toBe("Total: 0,00 €");
+    expect(run(["semana", "g.csv", "2026-02-30"], io)).toEqual({ code: 1, output: "Fecha no válida: 2026-02-30" });
+    expect(run(["semana", "g.csv"], io)).toEqual({ code: 1, output: "Fecha no válida:" });
