+      const iso = day.toISOString().slice(0, 10);
+      const dayExpenses = expenses.filter((expense) => expense.date === iso);
+      if (dayExpenses.length === 0) continue;
+      const cents = sumCents(dayExpenses);
+      total += cents;
+      lines.push(`${WEEKDAYS[i]} ${formatDate(iso)}: ${formatMoney(cents)}`);
+    }
+    return [...lines, `Total: ${formatMoney(total)}`].join("\n");
