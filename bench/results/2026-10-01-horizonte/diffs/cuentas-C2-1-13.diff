@@ -0,0 +1,30 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const shown = (output: string) => output.replace(/ /g, " ");
+
+const csv = [
+  "fecha,importe,categoria,descripcion",
+  "2026-03-01,9,casa,Domingo anterior",
+  "2026-03-02,40,casa,Luz",
+  "2026-03-02,5.2,ocio,Cine",
+  "2026-03-04,3.1,ocio,Café",
+  "2026-03-08,1,ocio,Domingo",
+  "2026-03-09,7,casa,Lunes siguiente",
+].join("\n");
+
+it("lists each day with expenses from Monday to Sunday and the total", () => {
+  const result = run(["semana", "g.csv", "2026-03-04"], memoryIo({ "g.csv": csv }));
+  expect(result.code).toBe(0);
+  expect(shown(result.output)).toBe(
+    ["Lunes 02/03/2026: 45,20 €", "Miércoles 04/03/2026: 3,10 €", "Domingo 08/03/2026: 1,00 €", "Total: 49,30 €"].join("\n"),
+  );
+});
+
+it("rejects a date that does not exist", () => {
+  expect(run(["semana", "g.csv", "2026-02-30"], memoryIo({ "g.csv": csv }))).toEqual({
+    code: 1,
+    output: "Fecha no válida: 2026-02-30",
+  });
+});
