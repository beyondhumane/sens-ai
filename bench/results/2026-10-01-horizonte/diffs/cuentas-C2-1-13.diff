+  semana: ([path, date = ""], io) => {
+    if (!isRealDate(date)) throw new Error(`Fecha no válida: ${date}`);
+    const day = new Date(`${date}T00:00:00Z`);
+    const offsetDay = (days: number) => new Date(day.getTime() + days * 86_400_000).toISOString().slice(0, 10);
+    const monday = offsetDay(-((day.getUTCDay() + 6) % 7));
+    const sunday = offsetDay(6 - ((day.getUTCDay() + 6) % 7));
+    const expenses = load(path, io).filter((expense) => expense.date >= monday && expense.date <= sunday);
+    const byDay = new Map<string, number>();
+    for (const { date: when, cents } of expenses) byDay.set(when, (byDay.get(when) ?? 0) + cents);
+    const lines = [...byDay].sort(([a], [b]) => a.localeCompare(b)).map(([when, cents]) => {
+      const name = new Date(`${when}T00:00:00Z`).toLocaleDateString("es-ES", { weekday: "long", timeZone: "UTC" });
+      return `${name.charAt(0).toUpperCase() + name.slice(1)} ${formatDate(when)}: ${formatMoney(cents)}`;
+    });
+    return [...lines, `Total: ${formatMoney(sumCents(expenses))}`].join("\n");
+  },
   informe: (args, io) => {
