+  if (header !== expectedHeader) throw new Error(`Cabecera desconocida: ${header}`);
+  return rows.filter((row) => row.trim() !== "").map((row) => row.split(","));
 }
 
+export function parseExpenses(text: string): Expense[] {
+  return dataRows(text, HEADER).map(([date, amount, category, ...rest]) => ({
+    date,
+    cents: Math.round(Number(amount) * 100),
+    category,
+    description: unquote(rest.join(",")),
+  }));
+}
+
+export const BUDGET_HEADER = "categoria,importe";
+
+export interface Budget {
+  category: string;
+  cents: number;
+}
+
+export const parseBudgets = (text: string): Budget[] =>
+  dataRows(text, BUDGET_HEADER).map(([category, amount]) => ({ category, cents: Math.round(Number(amount) * 100) }));
+
+export const formatBudgetRow = ({ category, cents }: Budget) => `${category},${(cents / 100).toFixed(2)}`;
+
 const unquote = (field: string) =>
   field.length >= 2 && field.startsWith('"') && field.endsWith('"') ? field.slice(1, -1).replaceAll('""', '"') : field;
 
diff --git a/tests/presupuesto.test.ts b/tests/presupuesto.test.ts
new file mode 100644
index 0000000..2b71e35
--- /dev/null
+++ b/tests/presupuesto.test.ts
@@ -0,0 +1,30 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+it("creates the file when it does not exist", () => {
+  const io = memoryIo({});
+  const ran = run(["presupuesto", "p.csv", "Comida", "100"], io);
+  expect(ran.code).toBe(0);
+  expect(ran.output.replace(/ /g, " ")).toBe("Presupuesto de Comida: 100,00 € al mes");
+  expect(io.files["p.csv"]).toBe("categoria,importe\nComida,100.00\n");
+});
+
+it("changes an existing category in place ignoring case and accents, keeping the new name", () => {
+  const io = memoryIo({ "p.csv": "categoria,importe\nOcio,20.00\nCafé,5.00\nCasa,50.00\n" });
+  run(["presupuesto", "p.csv", "CAFE", "7.5"], io);
+  expect(io.files["p.csv"]).toBe("categoria,importe\nOcio,20.00\nCAFE,7.50\nCasa,50.00\n");
+});
+
+it("appends a new category", () => {
+  const io = memoryIo({ "p.csv": "categoria,importe\nOcio,20.00\n" });
+  run(["presupuesto", "p.csv", "Casa", "50"], io);
+  expect(io.files["p.csv"]).toBe("categoria,importe\nOcio,20.00\nCasa,50.00\n");
+});
+
+it("validates the amount like añadir", () => {
+  const io = memoryIo({});
+  expect(run(["presupuesto", "p.csv", "Comida", "abc"], io)).toEqual({ code: 1, output: "Importe no válido: abc" });
+  expect(run(["presupuesto", "p.csv", "Comida", "0"], io).code).toBe(1);
+  expect(io.files["p.csv"]).toBeUndefined();
+});
