diff --git a/src/cli.ts b/src/cli.ts
index 076075a..653ca86 100644
--- a/src/cli.ts
+++ b/src/cli.ts
@@ -84,6 +84,18 @@ function dateFlag(args: string[], name: string): string | undefined {
   return date;
 }
 
+const sorters: Record<string, (a: Expense, b: Expense) => number> = {
+  fecha: (a, b) => a.date.localeCompare(b.date),
+  importe: (a, b) => b.cents - a.cents,
+};
+
+function orderFlag(args: string[]) {
+  const flag = args.indexOf("--orden");
+  const order = flag === -1 ? "fecha" : (args[flag + 1] ?? "");
+  if (!Object.hasOwn(sorters, order)) throw new Error(`Orden no válido: ${order}`);
+  return sorters[order];
+}
+
 const inMonth =(expenses: Expense[], month: string | undefined) =>
   expenses.filter((expense) => month === undefined || expense.date.startsWith(`${month}-`));
 
@@ -157,8 +169,10 @@ const commands: Record<string, Command> = {
   lista: (args, io) => {
     const from = dateFlag(args, "--desde");
     const to = dateFlag(args, "--hasta");
+    const byOrder = orderFlag(args);
     return load(args[0], io)
       .filter(({ date }) => (from === undefined || date >= from) && (to === undefined || date <= to))
+      .sort(byOrder)
       .map(formatLine)
       .join("\n");
   },
