diff --git a/tests/informe-anio.test.ts b/tests/informe-anio.test.ts
new file mode 100644
index 0000000..554c3c2
--- /dev/null
+++ b/tests/informe-anio.test.ts
@@ -0,0 +1,26 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const shown = (output: string) => output.replace(/ /g, " ");
+
+const csv = [
+  "fecha,importe,categoria,descripcion",
+  "2026-03-02,100,casa,Luz",
+  "2026-02-10,30,casa,Agua",
+  "2026-03-04,49.85,ocio,Cine",
+  "2025-12-01,500,casa,Otro año",
+].join("\n");
+
+it("lists one line per month with spending in calendar order, then the total", () => {
+  const result = run(["informe", "g.csv", "--anio", "2026"], memoryIo({ "g.csv": csv }));
+  expect(result.code).toBe(0);
+  expect(shown(result.output)).toBe("2026\n  Febrero: 30,00 €\n  Marzo: 149,85 €\nTotal: 179,85 €");
+});
+
+it("rejects an invalid year", () => {
+  expect(run(["informe", "g.csv", "--anio", "26"], memoryIo({ "g.csv": csv }))).toEqual({
+    code: 1,
+    output: "Año no válido: 26",
+  });
+});
