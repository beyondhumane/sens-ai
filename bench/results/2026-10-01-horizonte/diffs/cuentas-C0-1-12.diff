 const BUDGET_HEADER = "categoria,importe";
 
+function takeBudgetsPath(args: string[]): { path: string | undefined; rest: string[] } {
+  const flag = args.indexOf("--presupuestos");
+  if (flag === -1) return { path: undefined, rest: args };
+  const path = args[flag + 1];
+  if (path === undefined) throw new Error("Falta el fichero de presupuestos");
+  return { path, rest: args.filter((_, i) => i !== flag && i !== flag + 1) };
+}
+
+function loadBudgets(path: string, io: Io): Map<string, number> {
+  const [header, ...rows] = io.read(path).split(/\r?\n/);
+  if (header !== BUDGET_HEADER) throw new Error(`Cabecera desconocida: ${header}`);
+  const budgets = new Map<string, number>();
+  for (const row of rows) {
+    if (row.trim() === "") continue;
+    const comma = row.lastIndexOf(",");
+    budgets.set(fold(row.slice(0, comma)), Math.round(Number(row.slice(comma + 1)) * 100));
+  }
+  return budgets;
+}
+
+function budgetNote(spent: number, budget: number | undefined): string {
+  if (budget === undefined) return "";
+  const left = budget - spent;
+  const verdict = left >= 0 ? `quedan ${formatMoney(left)}` : `te pasas ${formatMoney(-left)}`;
+  return ` de ${formatMoney(budget)} (${verdict})`;
+}
+
