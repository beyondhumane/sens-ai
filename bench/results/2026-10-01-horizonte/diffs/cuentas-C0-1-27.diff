   });
 });
+
+describe("comparar", () => {
+  const csv = `fecha,importe,categoria,descripcion
+2026-02-03,40.00,Comida,a
+2026-02-10,90.00,Ocio,b
+2026-02-11,10.00,Casa,c
+2026-03-05,44.65,Comida,d
+2026-03-06,60.00,Ocio,e
+2026-03-07,5.00,Viajes,f
+2026-03-08,10.00,Casa,g
+2026-04-01,1.00,Otro,h
+`;
+  const io = memoryIo({ "gastos.csv": csv });
+
+  it("shows each month and the signed difference per category, alphabetically", () => {
+    const ran = run(["comparar", "gastos.csv", "2026-02", "2026-03"], io);
+    expect(ran.code).toBe(0);
+    expect(shown(ran.output)).toBe(
+      [
+        "Casa: 10,00 € → 10,00 € (+0,00 €)",
+        "Comida: 40,00 € → 44,65 € (+4,65 €)",
+        "Ocio: 90,00 € → 60,00 € (-30,00 €)",
+        "Viajes: 0,00 € → 5,00 € (+5,00 €)",
+      ].join("\n"),
+    );
+  });
+
+  it("validates months and handles empty months", () => {
+    expect(run(["comparar", "gastos.csv", "2026-02", "2026-13"], io)).toEqual({ code: 1, output: "Mes no válido: 2026-13" });
+    expect(run(["comparar", "gastos.csv", "2026-02"], io).code).toBe(1);
+    expect(run(["comparar", "gastos.csv", "2025-01", "2025-02"], io).output).toBe("Sin gastos");
+  });
+});
