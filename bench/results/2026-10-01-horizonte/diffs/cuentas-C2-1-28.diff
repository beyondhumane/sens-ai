diff --git a/tests/informe-csv.test.ts b/tests/informe-csv.test.ts
new file mode 100644
index 0000000..d17f6cf
--- /dev/null
+++ b/tests/informe-csv.test.ts
@@ -0,0 +1,29 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const files = () => ({
+  "g.csv": [
+    "fecha,importe,categoria,descripcion",
+    "2026-03-01,44.65,Comida,Cena",
+    "2026-03-02,60.00,Ocio,Teatro",
+    "2026-03-03,5.00,Casa,Luz",
+    "2026-03-04,15.35,Comida,Pan",
+    "2026-04-01,99.00,Viajes,Tren",
+  ].join("\n"),
+});
+
+it("saves the monthly report to a CSV in the same order as the report", () => {
+  const io = memoryIo(files());
+  const ran = run(["informe", "g.csv", "--mes", "2026-03", "--csv", "out.csv"], io);
+  expect(ran.code).toBe(0);
+  expect(ran.output).toContain("Comida");
+  expect(io.files["out.csv"]).toBe("categoria,total\nComida,60.00\nOcio,60.00\nCasa,5.00\n");
+});
+
+it("does not write a CSV without the flag and rejects a missing path", () => {
+  const io = memoryIo(files());
+  expect(run(["informe", "g.csv", "--mes", "2026-03"], io).code).toBe(0);
+  expect(Object.keys(io.files)).toEqual(["g.csv"]);
+  expect(run(["informe", "g.csv", "--mes", "2026-03", "--csv"], io).code).toBe(1);
+});
