diff --git a/src/cli.ts b/src/cli.ts
index 69a8e03..565fad8 100644
--- a/src/cli.ts
+++ b/src/cli.ts
@@ -21,6 +21,16 @@ const commands: Record<string, Command> = {
     load(args[0], io)
       .map((expense) => [formatDate(expense.date), expense.category, formatMoney(expense.cents), expense.description].join("  "))
       .join("\n"),
+  categorias: (args, io) => {
+    const totals = new Map<string, number>();
+    for (const expense of load(args[0], io)) {
+      totals.set(expense.category, (totals.get(expense.category) ?? 0) + expense.cents);
+    }
+    return [...totals]
+      .sort(([a, centsA], [b, centsB]) => centsB - centsA || a.localeCompare(b, "es"))
+      .map(([category, cents]) => `${category}: ${formatMoney(cents)}`)
+      .join("\n");
+  },
   total: (args, io) => `Total: ${formatMoney(load(args[0], io).reduce((sum, expense) => sum + expense.cents, 0))}`,
 };
 
