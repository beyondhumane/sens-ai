+describe("presupuesto", () => {
+  it("creates the file and replaces a category in place", () => {
+    const io = memoryIo({});
+    expect(shown(run(["presupuesto", "p.csv", "Comida", "100"], io).output)).toBe("Presupuesto de Comida: 100,00 € al mes");
+    run(["presupuesto", "p.csv", "Ocio", "30.5"], io);
+    expect(io.files["p.csv"]).toBe("categoria,importe\nComida,100.00\nOcio,30.50\n");
+    run(["presupuesto", "p.csv", "comída", "120"], io);
+    expect(io.files["p.csv"]).toBe("categoria,importe\ncomída,120.00\nOcio,30.50\n");
+  });
+
+  it("validates without touching the file", () => {
+    const io = memoryIo({ "p.csv": "categoria,importe\nComida,100.00\n" });
+    expect(run(["presupuesto", "p.csv", "Comida", "-3"], io)).toEqual({ code: 1, output: "Importe no válido: -3" });
+    expect(run(["presupuesto", "p.csv", "A,B", "3"], io)).toEqual({ code: 1, output: "Categoría no válida: A,B" });
+    expect(run(["presupuesto", "n.csv", "Ocio", "0"], io).code).toBe(1);
+    expect("n.csv" in io.files).toBe(false);
+    expect(io.files["p.csv"]).toBe("categoria,importe\nComida,100.00\n");
+  });
+});
