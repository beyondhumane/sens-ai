+describe("exportar", () => {
+  const CSV = `fecha,importe,categoria,descripcion
+2026-02-28,1.00,Ocio,Antes
+2026-03-01,12.50,Comida,"Pan, y fruta"
+2026-03-31,2.00,Ocio,Fin
+2026-04-01,3.00,Ocio,Despues
+`;
+
+  it("exports only the month given, with the same header and format", () => {
+    const io = memoryIo({ "g.csv": CSV });
+    expect(run(["exportar", "g.csv", "marzo.csv", "--mes", "2026-03"], io)).toEqual({
+      code: 0,
+      output: "Exportados 2 gastos a marzo.csv",
+    });
+    expect(io.files["marzo.csv"]).toBe(
+      'fecha,importe,categoria,descripcion\n2026-03-01,12.50,Comida,"Pan, y fruta"\n2026-03-31,2.00,Ocio,Fin\n',
+    );
+  });
+
+  it("exports everything without --mes and validates input", () => {
+    const io = memoryIo({ "g.csv": CSV });
+    expect(run(["exportar", "g.csv", "todo.csv"], io).output).toBe("Exportados 4 gastos a todo.csv");
+    expect(io.files["todo.csv"]).toBe(CSV);
+    expect(run(["exportar", "g.csv"], io)).toEqual({ code: 1, output: "Falta el fichero de salida" });
+    expect(run(["exportar", "g.csv", "x.csv", "--mes", "2026-13"], io)).toEqual({ code: 1, output: "Mes no válido: 2026-13" });
+    expect("x.csv" in io.files).toBe(false);
+  });
+});
