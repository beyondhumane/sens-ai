+const BANK_HEADER = "Fecha;Concepto;Importe";
+
+// Expense for a bank outflow, null for an income, undefined when the line is not understood.
+function parseBankLine(line: string): Expense | null | undefined {
+  const fields = line.split(";");
+  const match = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(fields[0]?.trim() ?? "");
+  const description = fields[1]?.trim();
+  if (fields.length !== 3 || !match || !description) return undefined;
+  const date = `${match[3]}-${match[2]}-${match[1]}`;
+  const amount = fields[2].trim();
+  const isExpense = amount.startsWith("-");
+  try {
+    const cents = parseCents(isExpense ? amount.slice(1) : amount);
+    if (!isRealDate(date)) return undefined;
+    return isExpense ? { date, cents, category: "Sin categoría", description } : null;
+  } catch {
+    return undefined;
+  }
+}
