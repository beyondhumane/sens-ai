@@ -0,0 +1,25 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const own = "fecha,importe,categoria,descripcion\n2026-03-01,5.00,Casa,Luz\n";
+
+it("appends only the bank expenses, as positive amounts, without category", () => {
+  const io = memoryIo({
+    "b.csv": "Fecha;Concepto;Importe\n09/03/2026;Bar Paco;-8,75\n10/03/2026;Nómina;1.850,00\n11/03/2026;Super, centro;-1.200,5\n",
+    "g.csv": own,
+  });
+  expect(run(["importar", "b.csv", "g.csv"], io)).toEqual({ code: 0, output: "Importados 2 gastos" });
+  expect(io.files["g.csv"]).toBe(`${own}2026-03-09,8.75,Sin categoría,Bar Paco\n2026-03-11,1200.50,Sin categoría,"Super, centro"\n`);
+});
+
+it("imports nothing and names the first line that is not understood", () => {
+  const io = memoryIo({
+    "b.csv": "Fecha;Concepto;Importe\n09/03/2026;Bar Paco;-8,75\n31/02/2026;Raro;-1,00\n",
+    "g.csv": own,
+  });
+  expect(run(["importar", "b.csv", "g.csv"], io)).toEqual({ code: 1, output: "Línea 3 del banco no válida" });
+  expect(io.files["g.csv"]).toBe(own);
+  io.files["b.csv"] = "Fecha;Concepto;Importe\n09/03/2026;Bar Paco;abc\n";
+  expect(run(["importar", "b.csv", "g.csv"], io).output).toBe("Línea 2 del banco no válida");
+});
