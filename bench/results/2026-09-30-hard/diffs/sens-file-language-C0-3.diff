+// The name a person knows a file's language by: TypeScript, Python, Markdown.
+// Nothing when the language is not recognized.
+export function languageTitleOf(path: string, text = "") {
+  const grammar = languageOf(path, text);
+  return grammar && Object.hasOwn(titles, grammar) ? titles[grammar] : null;
+}
+
 export function titleOf(tag: string) {
   const name = tag.trim().toLowerCase();
   if (Object.hasOwn(SHELL_TITLES, name)) return SHELL_TITLES[name];
