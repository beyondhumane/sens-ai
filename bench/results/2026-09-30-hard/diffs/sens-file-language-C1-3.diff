+// A file's language by its name; a script without an extension is only known by
+// the program its first line runs, so that one is read.
+function useLanguageTitle(file: DiffFile) {
+  const named = languageTitleOf(file.path);
+  const needsText = !named && file.state !== "D" && !file.binary && !stem(file.path).includes(".");
+  const [first, setFirst] = useState<{ path: string; text: string } | null>(null);
+  useEffect(() => {
+    if (!needsText) return;
+    let live = true;
+    commands.openFile(project.getState().work, file.path).then(
+      (opened) => live && opened.kind === "text" && setFirst({ path: file.path, text: opened.text.slice(0, 200) }),
+      () => {},
+    );
+    return () => {
+      live = false;
+    };
+  }, [needsText, file.path]);
+  return named ?? (needsText && first?.path === file.path ? languageTitleOf(file.path, first.text) : null);
+}
