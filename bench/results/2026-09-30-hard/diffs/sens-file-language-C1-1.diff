+// A file without an extension can be a script: its first line tells.
+function useLanguageName(file: DiffFile) {
+  const named = languageNameOf(file.path);
+  const script = !named && file.state !== "D" && !file.binary && !/[^/\\]\.[^/\\]*$/.test(file.path);
+  const [head, setHead] = useState("");
+  useEffect(() => {
+    setHead("");
+    if (!script) return;
+    let live = true;
+    commands.openFile(project.getState().work, file.path).then(
+      (opened) => live && opened.kind === "text" && setHead(opened.text.slice(0, 200)),
+      () => {},
+    );
+    return () => {
+      live = false;
+    };
+  }, [script, file.path]);
+  return named ?? (head ? languageNameOf(file.path, head) : null);
+}
