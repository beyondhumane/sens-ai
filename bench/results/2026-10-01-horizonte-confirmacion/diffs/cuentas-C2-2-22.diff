+    if (/[,\r\n]/.test(renamed)) throw new Error("Categoría no válida");
+    const expenses = load(path, io);
+    let count = 0;
+    const updated = expenses.map((expense) => {
+      if (plain(expense.category) !== plain(category)) return expense;
+      count++;
+      return { ...expense, category: renamed };
+    });
+    io.write(path, `${[HEADER, ...updated.map(csvRow)].join("\n")}\n`);
+    return `Renombrados ${count} gastos`;
