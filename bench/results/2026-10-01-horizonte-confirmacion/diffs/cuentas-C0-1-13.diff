diff --git a/tests/semana.test.ts b/tests/semana.test.ts
new file mode 100644
index 0000000..c794213
--- /dev/null
+++ b/tests/semana.test.ts
@@ -0,0 +1,37 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const csv = [
+  HEADER,
+  "2026-03-01,99.00,Ocio,domingo anterior",
+  "2026-03-02,40.00,Comida,menu",
+  "2026-03-02,5.20,Comida,cafe",
+  "2026-03-04,3.10,Ocio,libro",
+  "2026-03-08,1.00,Ocio,domingo",
+  "2026-03-09,99.00,Ocio,lunes siguiente",
+].join("\n");
+const norm = (text: string) => text.replace(/ /g, " ");
+const expected = "Lunes 02/03/2026: 45,20 €\nMiércoles 04/03/2026: 3,10 €\nDomingo 08/03/2026: 1,00 €\nTotal: 49,30 €";
+
+it("lists the days with expenses from Monday to Sunday and the total", () => {
+  const io = memoryIo({ "g.csv": csv });
+  for (const date of ["2026-03-02", "2026-03-05", "2026-03-08"]) {
+    const ran = run(["semana", "g.csv", date], io);
+    expect(ran.code).toBe(0);
+    expect(norm(ran.output)).toBe(expected);
+  }
+});
+
+it("handles a week without expenses and weeks crossing months", () => {
+  const io = memoryIo({ "g.csv": csv + "\n2026-02-28,2.00,Ocio,sabado\n" });
+  expect(norm(run(["semana", "g.csv", "2026-04-15"], io).output)).toBe("Total: 0,00 €");
+  expect(norm(run(["semana", "g.csv", "2026-03-01"], io).output)).toBe("Sábado 28/02/2026: 2,00 €\nDomingo 01/03/2026: 99,00 €\nTotal: 101,00 €");
+});
+
+it("rejects missing or impossible dates", () => {
+  const io = memoryIo({ "g.csv": csv });
+  expect(run(["semana", "g.csv", "2026-02-30"], io)).toEqual({ code: 1, output: "Fecha no válida: 2026-02-30" });
+  expect(run(["semana", "g.csv"], io)).toEqual({ code: 1, output: "Falta la fecha" });
+});
