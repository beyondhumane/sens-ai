diff --git a/tests/media.test.ts b/tests/media.test.ts
new file mode 100644
index 0000000..5946714
--- /dev/null
+++ b/tests/media.test.ts
@@ -0,0 +1,32 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const norm = (text: string) => text.replace(/ /g, " ");
+const csv = (rows: string[]) => [HEADER, ...rows].join("\n");
+
+it("divides the month total by all the days of the month", () => {
+  const io = memoryIo({ "g.csv": csv(["2026-03-01,100.00,Ocio,a", "2026-03-15,50.00,Comida,b", "2026-04-01,999.00,Ocio,otro mes"]) });
+  const ran = run(["media", "g.csv", "--mes", "2026-03"], io);
+  expect(ran.code).toBe(0);
+  expect(norm(ran.output)).toBe("Media diaria en marzo de 2026: 4,84 €");
+});
+
+it("uses the real length of the month and rounds to the cent", () => {
+  const io = memoryIo({ "g.csv": csv(["2028-02-10,29.00,Ocio,bisiesto", "2026-02-10,10.00,Ocio,normal"]) });
+  expect(norm(run(["media", "g.csv", "--mes", "2028-02"], io).output)).toBe("Media diaria en febrero de 2028: 1,00 €");
+  expect(norm(run(["media", "g.csv", "--mes", "2026-02"], io).output)).toBe("Media diaria en febrero de 2026: 0,36 €");
+});
+
+it("gives zero for a month without expenses and accepts the flag first", () => {
+  const io = memoryIo({ "g.csv": csv(["2026-03-01,10.00,Ocio,a"]) });
+  expect(norm(run(["media", "--mes", "2026-05", "g.csv"], io).output)).toBe("Media diaria en mayo de 2026: 0,00 €");
+});
+
+it("requires a valid month and a file", () => {
+  const io = memoryIo({ "g.csv": csv([]) });
+  expect(run(["media", "g.csv"], io)).toEqual({ code: 1, output: "Falta el mes" });
+  expect(run(["media", "g.csv", "--mes", "2026-13"], io)).toEqual({ code: 1, output: "Mes no válido: 2026-13" });
+  expect(run(["media", "--mes", "2026-03"], io)).toEqual({ code: 1, output: "Falta el fichero de gastos" });
+});
