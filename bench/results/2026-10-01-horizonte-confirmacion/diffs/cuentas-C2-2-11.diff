+  if (header !== expectedHeader) throw new Error(`Cabecera desconocida: ${header}`);
+  return rows.filter((row) => row.trim() !== "").map(splitFields);
+}
+
+export function parseExpenses(text: string): Expense[] {
+  return parseRows(text, HEADER).map(([date, amount, category, ...rest]) => ({
+    date,
+    cents: Math.round(Number(amount) * 100),
+    category,
+    description: rest.join(","),
+  }));
 }
 
 export const csvRow = (expense: Expense) =>
   `${expense.date},${(expense.cents / 100).toFixed(2)},${csvField(expense.category)},${csvField(expense.description)}`;
+
+export const BUDGET_HEADER = "categoria,importe";
+
+export interface Budget {
+  category: string;
+  cents: number;
+}
+
+export const parseBudgets = (text: string): Budget[] =>
+  parseRows(text, BUDGET_HEADER).map(([category, amount]) => ({ category, cents: Math.round(Number(amount) * 100) }));
+
+export const budgetRow = (budget: Budget) => `${csvField(budget.category)},${(budget.cents / 100).toFixed(2)}`;
