+  duplicados: (args, io) => {
+    const groups = new Map<string, Expense[]>();
+    for (const expense of load(args[0], io)) {
+      const key = [expense.date, expense.cents, fold(expense.description).trim().replace(/\s+/g, " ")].join("|");
+      groups.set(key, [...(groups.get(key) ?? []), expense]);
+    }
+    const lines = [...groups.values()]
+      .filter((group) => group.length > 1)
+      .map(([first, ...others]) => `${others.length + 1} veces: ${formatDate(first.date)}  ${formatMoney(first.cents)}  ${first.description}`);
+    return lines.length === 0 ? "Sin duplicados" : lines.join("\n");
+  },
   categorias: (args, io) =>
     sumByCategory(load(args[0], io))
       .map(([name, cents]) => `${name}: ${formatMoney(cents)}`)
