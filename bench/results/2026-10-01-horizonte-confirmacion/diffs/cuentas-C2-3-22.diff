+  renombrar: ([path, category, renamed], io) => {
+    const expenses = load(path, io);
+    if (!category) throw new Error("Falta la categoría");
+    if (!renamed) throw new Error("Falta la nueva categoría");
+    if (renamed.includes(",")) throw new Error(`Categoría no válida: ${renamed}`);
+    const key = plain(category);
+    let count = 0;
+    for (const expense of expenses) {
+      if (plain(expense.category) !== key) continue;
+      expense.category = renamed;
+      count++;
+    }
+    io.write(path!, `${HEADER}\n${expenses.map(formatExpense).join("")}`);
+    return `Renombrados ${count} gastos`;
+  },
