diff --git a/src/csv.ts b/src/csv.ts
index f21bd0a..21df691 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -2,13 +2,63 @@ import type { Expense } from "./expense";
 
 export const HEADER = "fecha,importe,categoria,descripcion";
 
+export function quoteField(text: string): string {
+  return /[,"]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+}
+
+function splitRecords(text: string): string[][] {
+  const records: string[][] = [];
+  let i = 0;
+  while (i < text.length) {
+    const fields: string[] = [];
+    let atEnd = false;
+    while (!atEnd) {
+      if (text[i] === '"') {
+        let value = "";
+        i++;
+        for (;;) {
+          if (i >= text.length) throw new Error("Comillas sin cerrar en el fichero");
+          if (text[i] === '"') {
+            if (text[i + 1] === '"') {
+              value += '"';
+              i += 2;
+              continue;
+            }
+            i++;
+            break;
+          }
+          value += text[i++];
+        }
+        fields.push(value);
+        if (text[i] === ",") i++;
+        else if (i >= text.length || text[i] === "\n" || text[i] === "\r") atEnd = true;
+        else throw new Error("Comillas mal colocadas en el fichero");
+      } else {
+        const start = i;
+        while (i < text.length && text[i] !== "," && text[i] !== "\n" && text[i] !== "\r") i++;
+        fields.push(text.slice(start, i));
+        if (text[i] === ",") i++;
+        else atEnd = true;
+      }
+      if (atEnd) {
+        if (text[i] === "\r") i++;
+        if (text[i] === "\n") i++;
+      }
+    }
+    records.push(fields);
+  }
+  return records;
+}
+
 export function parseExpenses(text: string): Expense[] {
-  const [header, ...rows] = text.trim().split(/\r?\n/);
-  if (header !== HEADER) throw new Error(`Cabecera desconocida: ${header}`);
+  const [header, ...rows] = splitRecords(text.trim());
+  if (header?.join(",") !== HEADER) throw new Error(`Cabecera desconocida: ${header?.join(",") ?? ""}`);
   return rows
-    .filter((row) => row.trim() !== "")
-    .map((row) => {
-      const [date, amount, category, ...rest] = row.split(",");
-      return { date, cents: Math.round(Number(amount) * 100), category, description: rest.join(",") };
-    });
+    .filter((row) => row.some((field) => field.trim() !== ""))
+    .map(([date, amount, category, ...rest]) => ({
+      date,
+      cents: Math.round(Number(amount) * 100),
+      category,
+      description: rest.join(","),
+    }));
 }
