@@ -0,0 +1,34 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const csv = [
+  HEADER,
+  "2026-02-28,99.00,Ocio,cine",
+  "2026-03-01,20.00,Comida,menu",
+  "2026-03-02,50.00,Ocio,teatro",
+  "2026-03-03,34.65,Comida,cena",
+  "2026-03-04,10.00,Ocio,libro",
+  "2026-03-05,30.00,Viajes,tren",
+].join("\n");
+const norm = (text: string) => text.replace(/ /g, " ");
+
+it("lists the categories over budget, the biggest excess first", () => {
+  const io = memoryIo({ "g.csv": csv, "p.csv": "categoria,importe\nCÓMIDA,50.00\nocio,55.00\nViajes,30.00\n" });
+  const ran = run(["avisos", "g.csv", "p.csv", "--mes", "2026-03"], io);
+  expect(ran.code).toBe(0);
+  expect(norm(ran.output)).toBe("Ocio: te pasas 5,00 €\nComida: te pasas 4,65 €");
+});
+
+it("says all is well when nothing exceeds, ignoring categories without budget", () => {
+  const io = memoryIo({ "g.csv": csv, "p.csv": "categoria,importe\nOcio,60.00\n" });
+  expect(run(["avisos", "g.csv", "p.csv", "--mes", "2026-03"], io)).toEqual({ code: 0, output: "Todo en orden" });
+});
+
+it("requires the month and the budget file", () => {
+  const io = memoryIo({ "g.csv": csv, "p.csv": "categoria,importe\n" });
+  expect(run(["avisos", "g.csv", "p.csv"], io)).toEqual({ code: 1, output: "Falta el mes" });
+  expect(run(["avisos", "g.csv", "--mes", "2026-03"], io)).toEqual({ code: 1, output: "Falta el fichero de presupuestos" });
+  expect(run(["avisos", "g.csv", "p.csv", "--mes", "2026-13"], io)).toEqual({ code: 1, output: "Mes no válido: 2026-13" });
+});
