diff --git a/tests/resumen.test.ts b/tests/resumen.test.ts
new file mode 100644
index 0000000..4e9bd29
--- /dev/null
+++ b/tests/resumen.test.ts
@@ -0,0 +1,31 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const norm = (text: string) => text.replace(/ /g, " ");
+const csv = (rows: string[]) => [HEADER, ...rows].join("\n");
+
+it("summarizes count, date range, total and biggest expense", () => {
+  const io = memoryIo({
+    "g.csv": csv(["2026-02-28,10.30,Ocio,Cine", "2026-01-15,120.00,Coche,Seguro del coche", "2026-01-03,282.00,Casa,Alquiler"]),
+  });
+  const ran = run(["resumen", "g.csv"], io);
+  expect(ran.code).toBe(0);
+  expect(norm(ran.output)).toBe(
+    "Gastos: 3\nDesde 03/01/2026 hasta 28/02/2026\nTotal: 412,30 €\nMayor: 282,00 € en Alquiler (03/01/2026)",
+  );
+});
+
+it("picks the first of several equal biggest expenses", () => {
+  const io = memoryIo({ "g.csv": csv(["2026-03-02,50.00,Ocio,Uno", "2026-03-01,50.00,Ocio,Dos"]) });
+  expect(norm(run(["resumen", "g.csv"], io).output).split("\n")[3]).toBe("Mayor: 50,00 € en Uno (02/03/2026)");
+});
+
+it("says there are no expenses", () => {
+  expect(run(["resumen", "g.csv"], memoryIo({ "g.csv": HEADER }))).toEqual({ code: 0, output: "Sin gastos" });
+});
+
+it("requires a file", () => {
+  expect(run(["resumen"], memoryIo({}))).toEqual({ code: 1, output: "Falta el fichero de gastos" });
+});
