+  comparar: (args, io) => {
+    const [path, monthA, monthB, ...extra] = args;
+    if (!path) throw new Error("Falta el fichero de gastos");
+    if (monthA === undefined || monthB === undefined || extra.length > 0) {
+      throw new Error("Uso: comparar <fichero> AAAA-MM AAAA-MM");
+    }
+    for (const month of [monthA, monthB]) {
+      if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(month)) throw new Error(`Mes no válido: ${month}`);
+    }
+    const totals = new Map<string, [number, number]>();
+    for (const expense of load(path, io)) {
+      const index = expense.date.startsWith(`${monthA}-`) ? 0 : expense.date.startsWith(`${monthB}-`) ? 1 : -1;
+      if (index === -1) continue;
+      const pair = totals.get(expense.category) ?? [0, 0];
+      pair[index] += expense.cents;
+      totals.set(expense.category, pair);
+    }
+    return [...totals]
+      .sort(([a], [b]) => a.localeCompare(b, "es"))
+      .map(([name, [before, after]]) => {
+        const diff = after - before;
+        return `${name}: ${formatMoney(before)} → ${formatMoney(after)} (${diff < 0 ? "-" : "+"}${formatMoney(Math.abs(diff))})`;
+      })
+      .join("\n");
+  },
   resumen: (args, io) => {
     const expenses = load(args[0], io);
     if (expenses.length === 0) return "Sin gastos";
