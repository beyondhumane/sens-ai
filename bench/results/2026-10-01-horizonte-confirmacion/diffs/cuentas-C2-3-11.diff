 const plain = (text: string) => text.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase();
 
+function parseAmount(amount: string): number {
+  const cents = Math.round(Number(amount) * 100);
+  if (!/^\d+(\.\d{1,2})?$/.test(amount) || cents <= 0) throw new Error(`Importe no válido: ${amount}`);
+  return cents;
+}
+
+const BUDGET_HEADER = "categoria,importe";
+
+function parseBudgets(text: string): { category: string; cents: number }[] {
+  const [header, ...rows] = text.trim().split(/\r?\n/);
+  if (header !== BUDGET_HEADER) throw new Error(`Cabecera desconocida: ${header}`);
+  return rows
+    .filter((row) => row.trim() !== "")
+    .map((row) => {
+      const [category, amount] = row.split(",");
+      return { category, cents: Math.round(Number(amount) * 100) };
+    });
+}
