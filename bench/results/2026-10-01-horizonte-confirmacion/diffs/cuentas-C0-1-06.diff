diff --git a/tests/informe.test.ts b/tests/informe.test.ts
new file mode 100644
index 0000000..e1a1e56
--- /dev/null
+++ b/tests/informe.test.ts
@@ -0,0 +1,34 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const csv = [
+  HEADER,
+  "2026-02-28,99.00,Ocio,cine",
+  "2026-03-01,20.00,Comida,menu",
+  "2026-03-02,50.00,Ocio,teatro",
+  "2026-03-03,24.65,Comida,cena",
+  "2026-03-04,10.00,Ocio,libro",
+].join("\n");
+const norm = (text: string) => text.replace(/ /g, " ");
+
+it("reports the month by category, biggest first, with the total", () => {
+  const ran = run(["informe", "g.csv", "--mes", "2026-03"], memoryIo({ "g.csv": csv }));
+  expect(ran.code).toBe(0);
+  expect(norm(ran.output)).toBe("Marzo de 2026\n  Ocio: 60,00 €\n  Comida: 44,65 €\nTotal: 104,65 €");
+});
+
+it("accepts --mes before the file", () => {
+  expect(norm(run(["informe", "--mes", "2026-02", "g.csv"], memoryIo({ "g.csv": csv })).output)).toBe("Febrero de 2026\n  Ocio: 99,00 €\nTotal: 99,00 €");
+});
+
+it("reports an empty month", () => {
+  expect(norm(run(["informe", "g.csv", "--mes", "2026-04"], memoryIo({ "g.csv": csv })).output)).toBe("Abril de 2026\nTotal: 0,00 €");
+});
+
+it("requires a valid month", () => {
+  const io = memoryIo({ "g.csv": csv });
+  expect(run(["informe", "g.csv"], io)).toEqual({ code: 1, output: "Falta el mes" });
+  expect(run(["informe", "g.csv", "--mes", "2026-13"], io)).toEqual({ code: 1, output: "Mes no válido: 2026-13" });
+});
