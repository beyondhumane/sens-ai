+  duplicados: (args, io) => {
+    const groups = new Map<string, { first: Expense; count: number }>();
+    for (const expense of load(args[0], io)) {
+      const key = [expense.date, expense.cents, fold(expense.description.replace(/\s+/g, " ").trim())].join("|");
+      const group = groups.get(key);
+      if (group) group.count++;
+      else groups.set(key, { first: expense, count: 1 });
+    }
+    const lines = [...groups.values()]
+      .filter((group) => group.count > 1)
+      .map(({ first, count }) => `${count} veces: ${[formatDate(first.date), formatMoney(first.cents), first.description].join("  ")}`);
+    return lines.length === 0 ? "Sin duplicados" : lines.join("\n");
+  },
