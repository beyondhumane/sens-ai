diff --git a/tests/presupuesto.test.ts b/tests/presupuesto.test.ts
new file mode 100644
index 0000000..5af896e
--- /dev/null
+++ b/tests/presupuesto.test.ts
@@ -0,0 +1,39 @@
+import { describe, expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const shown = (output: string) => output.replace(/ /g, " ");
+
+describe("presupuesto", () => {
+  it("creates the file when missing", () => {
+    const io = memoryIo({});
+    const ran = run(["presupuesto", "p.csv", "Comida", "100"], io);
+    expect(ran.code).toBe(0);
+    expect(shown(ran.output)).toBe("Presupuesto de Comida: 100,00 € al mes");
+    expect(io.files["p.csv"]).toBe("categoria,importe\nComida,100.00\n");
+  });
+
+  it("replaces in place ignoring case and accents, keeping the new name", () => {
+    const io = memoryIo({ "p.csv": "categoria,importe\nComida,100.00\nOcio,50.00\n" });
+    run(["presupuesto", "p.csv", "CÓMIDA", "120.5"], io);
+    expect(io.files["p.csv"]).toBe("categoria,importe\nCÓMIDA,120.50\nOcio,50.00\n");
+  });
+
+  it("appends a new category", () => {
+    const io = memoryIo({ "p.csv": "categoria,importe\nComida,100.00\n" });
+    run(["presupuesto", "p.csv", "Ocio", "50"], io);
+    expect(io.files["p.csv"]).toBe("categoria,importe\nComida,100.00\nOcio,50.00\n");
+  });
+
+  it("rejects bad input without touching the file", () => {
+    const files = { "p.csv": "categoria,importe\nComida,100.00\n" };
+    for (const amount of ["0", "-1", "abc", "1.234", "1,5"]) {
+      const ran = run(["presupuesto", "p.csv", "Comida", amount], memoryIo(files));
+      expect(ran).toEqual({ code: 1, output: `Importe no válido: ${amount}` });
+    }
+    expect(run(["presupuesto", "p.csv", "A,B", "5"], memoryIo(files)).code).toBe(1);
+    expect(run(["presupuesto", "p.csv", " ", "5"], memoryIo(files)).output).toBe("Falta la categoría");
+    expect(run(["presupuesto", "p.csv", "Comida", "5"], memoryIo({ "p.csv": "x,y\n" })).code).toBe(1);
+    expect(files["p.csv"]).toBe("categoria,importe\nComida,100.00\n");
+  });
+});
