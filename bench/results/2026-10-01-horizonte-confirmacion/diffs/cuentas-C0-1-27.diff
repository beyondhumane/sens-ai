@@ -0,0 +1,36 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const norm = (text: string) => text.replace(/ /g, " ");
+const csv = (rows: string[]) => [HEADER, ...rows].join("\n");
+
+it("compares each category between two months with a signed difference, alphabetically", () => {
+  const io = memoryIo({
+    "g.csv": csv([
+      "2026-02-03,40.00,Comida,a",
+      "2026-03-04,44.65,Comida,b",
+      "2026-02-05,50.00,Ocio,c",
+      "2026-02-06,40.00,Ocio,d",
+      "2026-03-07,60.00,Ocio,e",
+      "2026-04-01,999.00,Casa,otro mes",
+    ]),
+  });
+  const ran = run(["comparar", "g.csv", "2026-02", "2026-03"], io);
+  expect(ran.code).toBe(0);
+  expect(norm(ran.output)).toBe("Comida: 40,00 € → 44,65 € (+4,65 €)\nOcio: 90,00 € → 60,00 € (-30,00 €)");
+});
+
+it("includes categories with spending in only one month and a plus sign when equal", () => {
+  const io = memoryIo({ "g.csv": csv(["2026-02-03,10.00,Zoo,a", "2026-03-03,5.00,Arte,b", "2026-02-04,7.00,Pan,c", "2026-03-04,7.00,Pan,d"]) });
+  expect(norm(run(["comparar", "g.csv", "2026-02", "2026-03"], io).output)).toBe(
+    "Arte: 0,00 € → 5,00 € (+5,00 €)\nPan: 7,00 € → 7,00 € (+0,00 €)\nZoo: 10,00 € → 0,00 € (-10,00 €)",
+  );
+});
+
+it("validates the months", () => {
+  const io = memoryIo({ "g.csv": csv([]) });
+  expect(run(["comparar", "g.csv", "2026-02"], io)).toEqual({ code: 1, output: "Faltan los meses" });
+  expect(run(["comparar", "g.csv", "2026-02", "2026-13"], io)).toEqual({ code: 1, output: "Mes no válido: 2026-13" });
+});
