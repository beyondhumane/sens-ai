+    expect(io.files["g.csv"]).toBe("fecha,importe,categoria,descripcion\n2026-03-01,12.50,Alimentación,Pan\n2026-03-02,3.00,Alimentación,\"Café, solo\"\n2026-03-03,5.00,Ocio,Cine\n");
+    expect(run(["renombrar", "g.csv", "Nada", "X"], io)).toEqual({ code: 0, output: "Renombrados 0 gastos" });
