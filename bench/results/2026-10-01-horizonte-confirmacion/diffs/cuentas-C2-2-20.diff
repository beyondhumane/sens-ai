+      groups.set(key, [...(groups.get(key) ?? []), expense]);
+    }
+    const repeated = [...groups.values()].filter((group) => group.length > 1);
+    return repeated.length === 0
+      ? "Sin duplicados"
+      : repeated
+          .map(([first, ...rest]) => {
+            const text = [formatDate(first.date), formatMoney(first.cents), first.description].join("  ");
