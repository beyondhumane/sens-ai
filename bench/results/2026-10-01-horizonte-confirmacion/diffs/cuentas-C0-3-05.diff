+    const [path, date = "", amount = "", category = "", ...words] = args;
+    const description = words.join(" ").trim();
+    if (!path) throw new Error("Falta el fichero de gastos");
+    if (!isRealDate(date)) throw new Error(`Fecha no válida: ${date}`);
+    if (!/^\d+(\.\d{1,2})?$/.test(amount) || Number(amount) <= 0) throw new Error(`Importe no válido: ${amount}`);
+    if (category.trim() === "" || /[,\r\n]/.test(category)) throw new Error(`Categoría no válida: ${category}`);
