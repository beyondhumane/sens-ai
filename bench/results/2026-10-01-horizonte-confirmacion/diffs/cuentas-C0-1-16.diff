diff --git a/tests/importar.test.ts b/tests/importar.test.ts
new file mode 100644
index 0000000..2f0f2d7
--- /dev/null
+++ b/tests/importar.test.ts
@@ -0,0 +1,27 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const bank = "Fecha;Concepto;Importe\n09/03/2026;Bar Paco;-8,75\n10/03/2026;Nómina;1.850,00\n";
+
+it("appends only the negative amounts as expenses", () => {
+  const io = memoryIo({ "b.csv": bank, "g.csv": `${HEADER}\n2026-03-01,1.00,Ocio,x\n` });
+  expect(run(["importar", "b.csv", "g.csv"], io)).toEqual({ code: 0, output: "Importados 1 gastos" });
+  expect(io.files["g.csv"]).toBe(`${HEADER}\n2026-03-01,1.00,Ocio,x\n2026-03-09,8.75,Sin categoría,Bar Paco\n`);
+});
+
+it("handles thousands, quoting and CRLF", () => {
+  const io = memoryIo({ "b.csv": "Fecha;Concepto;Importe\r\n01/02/2026;Tienda, \"X\";-1.234,5\r\n", "g.csv": `${HEADER}\n` });
+  expect(run(["importar", "b.csv", "g.csv"], io).output).toBe("Importados 1 gastos");
+  expect(io.files["g.csv"]).toBe(`${HEADER}\n2026-02-01,1234.50,Sin categoría,"Tienda, ""X"""\n`);
+});
+
+it("imports nothing and names the first bad line", () => {
+  for (const bad of ["31/02/2026;A;-1,00", "09/03/2026;A;abc", "09/03/2026;A", "09/03/2026;;-1,00", "2026-03-09;A;-1,00"]) {
+    const g = `${HEADER}\n`;
+    const io = memoryIo({ "b.csv": `Fecha;Concepto;Importe\n09/03/2026;Ok;-1,00\n${bad}\n`, "g.csv": g });
+    expect(run(["importar", "b.csv", "g.csv"], io)).toEqual({ code: 1, output: "Línea 3 del banco no válida" });
+    expect(io.files["g.csv"]).toBe(g);
+  }
+});
