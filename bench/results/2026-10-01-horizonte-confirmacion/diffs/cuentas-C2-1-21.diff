diff --git a/tests/avisos.test.ts b/tests/avisos.test.ts
new file mode 100644
index 0000000..8fcfb76
--- /dev/null
+++ b/tests/avisos.test.ts
@@ -0,0 +1,26 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const avisos = (rows: string[], budgets: string, extra = ["--mes", "2026-03"]) =>
+  run(["avisos", "g.csv", "p.csv", ...extra], memoryIo({ "g.csv": [HEADER, ...rows].join("\n"), "p.csv": `categoria,importe\n${budgets}\n` }));
+const clean = (text: string) => text.replace(/[^\S\n]/g, " ");
+
+it("lists categories over budget, most excess first, using the expenses' spelling", () => {
+  const { code, output } = avisos(
+    ["2026-03-02,35,Ocio,Cine", "2026-03-03,150,Comida,Super", "2026-03-04,40,Ropa,Camisa", "2026-03-05,99,Ocio,Teatro", "2026-04-01,500,Ropa,Abrigo"],
+    "COMIDA,100.00\nócio,30.00\nropa,50.00",
+  );
+  expect(code).toBe(0);
+  expect(clean(output)).toBe("Ocio: te pasas 104,00 €\nComida: te pasas 50,00 €");
+});
+
+it("says all is fine when nothing goes over, including categories without budget", () => {
+  expect(avisos(["2026-03-02,30,Ocio,Cine", "2026-03-02,900,Otros,X"], "Ocio,30.00")).toEqual({ code: 0, output: "Todo en orden" });
+});
+
+it("requires month and budgets file", () => {
+  expect(avisos([], "Ocio,1", []).output).toBe("Falta el mes (--mes AAAA-MM)");
+  expect(run(["avisos", "g.csv", "--mes", "2026-03"], memoryIo({ "g.csv": HEADER })).output).toBe("Falta el fichero de presupuestos");
+});
