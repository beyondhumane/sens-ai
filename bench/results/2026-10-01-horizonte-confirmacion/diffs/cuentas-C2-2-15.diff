 function parseCents(amount: string): number {
-  const cents = Math.round(Number(amount) * 100);
-  if (!/^\d+(\.\d{1,2})?$/.test(amount) || cents <= 0) throw new Error(`Importe no válido: ${amount}`);
+  const comma = amount.includes(",");
+  const valid = comma ? /^(\d+|\d{1,3}(\.\d{3})+),\d{1,2}$/.test(amount) : /^\d+(\.\d{1,2})?$/.test(amount);
+  const normalized = comma ? amount.replace(/\./g, "").replace(",", ".") : amount;
+  const cents = valid ? Math.round(Number(normalized) * 100) : 0;
+  if (cents <= 0) throw new Error(`Importe no válido: ${amount}`);
   return cents;
 }
 
