+function takeDate(args: string[], flag: string): { date: string | undefined; rest: string[] } {
+  const index = args.indexOf(flag);
+  if (index === -1) return { date: undefined, rest: args };
+  const date = args[index + 1];
+  if (date === undefined || !isRealDate(date)) throw new Error(`Fecha no válida: ${date ?? ""}`.trim());
+  return { date, rest: [...args.slice(0, index), ...args.slice(index + 2)] };
+}
