diff --git a/tests/exportar.test.ts b/tests/exportar.test.ts
new file mode 100644
index 0000000..8bdaa0c
--- /dev/null
+++ b/tests/exportar.test.ts
@@ -0,0 +1,30 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const header = "fecha,importe,categoria,descripcion";
+const source = `${header}\n2026-02-28,1.50,Ocio,Cine\n2026-03-05,18.00,Ocio,"Cena, con amigos"\n2026-03-06,2.5,Comida,Pan\n2026-04-01,9.00,Ocio,Libro\n`;
+
+it("exports only the given month keeping header and row format", () => {
+  const io = memoryIo({ "g.csv": source });
+  const ran = run(["exportar", "g.csv", "marzo.csv", "--mes", "2026-03"], io);
+  expect(ran).toEqual({ code: 0, output: "Exportados 2 gastos a marzo.csv" });
+  expect(io.files["marzo.csv"]).toBe(`${header}\n2026-03-05,18.00,Ocio,"Cena, con amigos"\n2026-03-06,2.5,Comida,Pan\n`);
+  expect(io.files["g.csv"]).toBe(source);
+});
+
+it("exports everything without --mes, and accepts the flag first", () => {
+  const io = memoryIo({ "g.csv": source });
+  expect(run(["exportar", "g.csv", "todo.csv"], io).output).toBe("Exportados 4 gastos a todo.csv");
+  expect(io.files["todo.csv"]).toBe(source);
+  expect(run(["exportar", "--mes", "2026-04", "g.csv", "abril.csv"], io).output).toBe("Exportados 1 gastos a abril.csv");
+});
+
+it.each([
+  [["exportar", "g.csv"], "Falta el fichero de salida"],
+  [["exportar", "g.csv", "o.csv", "--mes", "2026-13"], "Mes no válido: 2026-13"],
+])("rejects %j", (argv, message) => {
+  const io = memoryIo({ "g.csv": source });
+  expect(run(argv, io)).toEqual({ code: 1, output: message });
+  expect(io.files["o.csv"]).toBeUndefined();
+});
