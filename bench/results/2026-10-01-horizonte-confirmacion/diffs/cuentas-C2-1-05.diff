+++ b/tests/anadir.test.ts
@@ -0,0 +1,32 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+import { formatMoney } from "../src/money";
+
+const csv = "fecha,importe,categoria,descripcion\n2026-03-01,3.50,ocio,Café";
+
+it("appends the expense at the end and reports it", () => {
+  const io = memoryIo({ "g.csv": `${csv}\n` });
+  const ran = run(["añadir", "g.csv", "2026-03-19", "4.2", "Comida", "Churros", "con", "chocolate"], io);
+  expect(ran).toEqual({ code: 0, output: `Añadido: 19/03/2026  Comida  ${formatMoney(420)}  Churros con chocolate` });
+  expect(io.files["g.csv"]).toBe(`${csv}\n2026-03-19,4.20,Comida,Churros con chocolate\n`);
+});
+
+it("adds the missing line break when the file does not end with one", () => {
+  const io = memoryIo({ "g.csv": csv });
+  run(["añadir", "g.csv", "2026-03-19", "4.20", "Comida", "Churros"], io);
+  expect(io.files["g.csv"]).toBe(`${csv}\n2026-03-19,4.20,Comida,Churros\n`);
+});
+
+it.each([
+  [["2026-02-30", "4.20"], "Fecha no válida: 2026-02-30"],
+  [["19/03/2026", "4.20"], "Fecha no válida: 19/03/2026"],
+  [["2026-03-19", "-3"], "Importe no válido: -3"],
+  [["2026-03-19", "0"], "Importe no válido: 0"],
+  [["2026-03-19", "1.234"], "Importe no válido: 1.234"],
+  [["2026-03-19", "1,5"], "Importe no válido: 1,5"],
+])("rejects %j without touching the file", ([date, amount], message) => {
+  const io = memoryIo({ "g.csv": csv });
+  expect(run(["añadir", "g.csv", date, amount, "Comida", "Churros"], io)).toEqual({ code: 1, output: message });
+  expect(io.files["g.csv"]).toBe(csv);
+});
