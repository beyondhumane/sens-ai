diff --git a/src/date.ts b/src/date.ts
index f3020d7..d91bcc7 100644
--- a/src/date.ts
+++ b/src/date.ts
@@ -13,6 +13,14 @@ const MONTHS = [
   "Diciembre",
 ];
 
+const WEEKDAYS = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"];
+
+export function weekOf(iso: string): { date: string; name: string }[] {
+  const day = new Date(`${iso}T00:00:00Z`);
+  const monday = day.getTime() - ((day.getUTCDay() + 6) % 7) * 86_400_000;
+  return WEEKDAYS.map((name, i) => ({ date: new Date(monday + i * 86_400_000).toISOString().slice(0, 10), name }));
+}
+
 export function isValidDate(date: string): boolean {
   const parsed = new Date(`${date}T00:00:00Z`);
   return /^\d{4}-\d{2}-\d{2}$/.test(date) && !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === date;
