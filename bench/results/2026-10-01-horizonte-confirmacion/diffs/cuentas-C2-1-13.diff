@@ -0,0 +1,36 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const csv = [
+  HEADER,
+  "2026-02-27,9,comida,antes",
+  "2026-03-02,40,comida,a",
+  "2026-03-02,5.20,ocio,b",
+  "2026-03-04,3.10,ocio,c",
+  "2026-03-08,1,ocio,domingo",
+  "2026-03-09,7,comida,despues",
+].join("\n");
+const semana = (...args: string[]) => run(["semana", ...args], memoryIo({ "g.csv": csv }));
+const clean = (text: string) => text.replace(/[^\S\n]/g, " ");
+
+it("lists each day with expenses from Monday to Sunday, then the total", () => {
+  const { code, output } = semana("g.csv", "2026-03-05");
+  expect(code).toBe(0);
+  expect(clean(output)).toBe(
+    ["Lunes 02/03/2026: 45,20 €", "Miércoles 04/03/2026: 3,10 €", "Domingo 08/03/2026: 1,00 €", "Total: 49,30 €"].join("\n"),
+  );
+});
+
+it("works when the date is a Sunday", () => {
+  expect(clean(semana("g.csv", "2026-03-08").output)).toContain("Lunes 02/03/2026");
+});
+
+it("shows only the total for a week without expenses", () => {
+  expect(clean(semana("g.csv", "2026-06-01").output)).toBe("Total: 0,00 €");
+});
+
+it("rejects a date that does not exist", () => {
+  expect(semana("g.csv", "2026-02-30")).toEqual({ code: 1, output: "Fecha no válida: 2026-02-30" });
+});
