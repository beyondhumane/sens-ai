+
+it("saves the monthly report to a CSV with --csv", () => {
+  const io = memoryIo({ "g.csv": csv });
+  const ran = run(["informe", "g.csv", "--mes", "2026-03", "--csv", "out.csv"], io);
+  expect(norm(ran.output)).toBe("Marzo de 2026\n  Ocio: 60,00 €\n  Comida: 44,65 €\nTotal: 104,65 €");
+  expect(io.files["out.csv"]).toBe("categoria,total\nOcio,60.00\nComida,44.65\n");
+});
+
+it("requires an output file for --csv and rejects it with --anio", () => {
+  const io = memoryIo({ "g.csv": csv });
+  expect(run(["informe", "g.csv", "--mes", "2026-03", "--csv"], io)).toEqual({ code: 1, output: "Falta el fichero de salida" });
+  expect(run(["informe", "g.csv", "--anio", "2026", "--csv", "o.csv"], io).code).toBe(1);
+});
