+    expect(io.files["gastos.csv"]).toBe(`${GASTOS}2026-03-19,4.20,Comida,Churros con chocolate\n`);
+
+    const before = io.files["gastos.csv"];
+    const add = (date: string, amount: string) => run(["añadir", "gastos.csv", date, amount, "Comida", "X"], io);
