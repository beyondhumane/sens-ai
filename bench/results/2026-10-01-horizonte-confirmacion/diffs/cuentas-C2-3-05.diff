+  añadir: ([path, date = "", amount = "", category, ...words], io) => {
+    if (!path) throw new Error("Falta el fichero de gastos");
+    const validDate = /^\d{4}-\d{2}-\d{2}$/.test(date) && new Date(`${date}T00:00:00Z`).toISOString().slice(0, 10) === date;
+    if (!validDate) throw new Error(`Fecha no válida: ${date}`);
+    const cents = Math.round(Number(amount) * 100);
+    if (!/^\d+(\.\d{1,2})?$/.test(amount) || cents <= 0) throw new Error(`Importe no válido: ${amount}`);
+    const description = words.join(" ");
+    if (!category) throw new Error("Falta la categoría");
+    if (!description) throw new Error("Falta la descripción");
+    if (category.includes(",")) throw new Error(`Categoría no válida: ${category}`);
+    const text = io.read(path);
+    const expense: Expense = { date, cents, category, description };
+    io.write(path, `${text}${text.endsWith("\n") ? "" : "\n"}${date},${(cents / 100).toFixed(2)},${category},${description}\n`);
+    return `Añadido: ${formatLine(expense)}`;
+  },
