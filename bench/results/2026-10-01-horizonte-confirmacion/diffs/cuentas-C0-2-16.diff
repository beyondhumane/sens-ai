+function splitBankLine(line: string): string[] | undefined {
+  const fields: string[] = [];
+  let field = "";
+  let quoted = false;
+  for (let i = 0; i < line.length; i++) {
+    const ch = line[i];
+    if (quoted) {
+      if (ch !== '"') field += ch;
+      else if (line[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else quoted = false;
+    } else if (ch === '"' && field === "") quoted = true;
+    else if (ch === ";") {
+      fields.push(field);
+      field = "";
+    } else field += ch;
+  }
+  if (quoted) return undefined;
+  fields.push(field);
+  return fields;
+}
+
+// undefined: línea no válida; null: válida pero no es un gasto
+function parseBankLine(line: string): Expense | null | undefined {
+  const fields = splitBankLine(line);
+  if (fields === undefined || fields.length !== 3) return undefined;
+  const [rawDate, rawConcept, rawAmount] = fields.map((f) => f.trim());
+  const match = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(rawDate);
+  if (!match) return undefined;
+  const date = `${match[3]}-${match[2]}-${match[1]}`;
+  if (!isRealDate(date)) return undefined;
+  const description = rawConcept.replace(/\s+/g, " ");
+  if (description === "") return undefined;
+  const sign = /^[+-]/.test(rawAmount) ? rawAmount[0] : "";
+  const unsigned = sign === "" ? rawAmount : rawAmount.slice(1);
+  if (/^0+(,0{1,2})?$/.test(unsigned)) return null;
+  const cents = /^[\d.]+$/.test(unsigned) && unsigned.includes(".") ? undefined : parseAmount(unsigned);
+  if (cents === undefined) return undefined;
+  return sign === "-" ? { date, cents, category: "Sin categoría", description } : null;
+}
