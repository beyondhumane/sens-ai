diff --git a/src/date.ts b/src/date.ts
index 545fa02..4fe80d6 100644
--- a/src/date.ts
+++ b/src/date.ts
@@ -16,3 +16,20 @@ export function isRealDate(iso: string): boolean {
 export function formatDate(iso: string): string {
   return dates.format(new Date(iso));
 }
+
+const weekdays = new Intl.DateTimeFormat("es-ES", { weekday: "long", timeZone: "UTC" });
+
+export function formatWeekday(iso: string): string {
+  const text = weekdays.format(new Date(iso));
+  return text.charAt(0).toUpperCase() + text.slice(1);
+}
+
+export function weekOf(iso: string): string[] {
+  const day = new Date(iso);
+  const sinceMonday = (day.getUTCDay() + 6) % 7;
+  return Array.from({ length: 7 }, (_, index) => {
+    const date = new Date(day);
+    date.setUTCDate(day.getUTCDate() - sinceMonday + index);
+    return date.toISOString().slice(0, 10);
+  });
+}
