diff --git a/src/csv.ts b/src/csv.ts
index f21bd0a..dbad4cb 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -2,13 +2,37 @@ import type { Expense } from "./expense";
 
 export const HEADER = "fecha,importe,categoria,descripcion";
 
+function splitFields(row: string): string[] {
+  const fields: string[] = [];
+  let field = "";
+  let quoted = false;
+  for (let i = 0; i < row.length; i++) {
+    const char = row[i];
+    if (quoted) {
+      if (char !== '"') field += char;
+      else if (row[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else quoted = false;
+    } else if (char === '"' && field === "") quoted = true;
+    else if (char === ",") {
+      fields.push(field);
+      field = "";
+    } else field += char;
+  }
+  fields.push(field);
+  return fields;
+}
+
+export const csvField = (text: string) => (/[",]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text);
+
 export function parseExpenses(text: string): Expense[] {
   const [header, ...rows] = text.trim().split(/\r?\n/);
   if (header !== HEADER) throw new Error(`Cabecera desconocida: ${header}`);
   return rows
     .filter((row) => row.trim() !== "")
     .map((row) => {
-      const [date, amount, category, ...rest] = row.split(",");
+      const [date, amount, category, ...rest] = splitFields(row);
       return { date, cents: Math.round(Number(amount) * 100), category, description: rest.join(",") };
     });
 }
