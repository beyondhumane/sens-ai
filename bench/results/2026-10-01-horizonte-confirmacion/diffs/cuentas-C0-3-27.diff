+  comparar: (args, io) => {
+    const [path, first = "", second = ""] = args;
+    for (const month of [first, second]) {
+      if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(month)) throw new Error(`Mes no válido: ${month}`);
+    }
+    const expenses = load(path, io);
+    const before = new Map(sumByCategory(inMonth(expenses, first)));
+    const after = new Map(sumByCategory(inMonth(expenses, second)));
+    const names = [...new Set([...before.keys(), ...after.keys()])].sort((a, b) => a.localeCompare(b, "es"));
+    if (names.length === 0) return "Sin gastos";
+    return names
+      .map((name) => {
+        const from = before.get(name) ?? 0;
+        const to = after.get(name) ?? 0;
+        const diff = to - from;
+        return `${name}: ${formatMoney(from)} → ${formatMoney(to)} (${diff < 0 ? "-" : "+"}${formatMoney(Math.abs(diff))})`;
+      })
+      .join("\n");
+  },
