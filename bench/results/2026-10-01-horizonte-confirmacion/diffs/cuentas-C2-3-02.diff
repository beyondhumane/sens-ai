+  categorias: (args, io) => {
+    const totals = new Map<string, number>();
+    for (const { category, cents } of load(args[0], io)) totals.set(category, (totals.get(category) ?? 0) + cents);
+    return [...totals]
+      .sort(([a, centsA], [b, centsB]) => centsB - centsA || a.localeCompare(b, "es"))
+      .map(([category, cents]) => `${category}: ${formatMoney(cents)}`)
+      .join("\n");
+  },
 };
 
