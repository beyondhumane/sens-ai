+  duplicados: (args, io) => {
+    const groups = new Map<string, Expense[]>();
+    for (const expense of load(args[0], io)) {
+      const key = [expense.date, expense.cents, plain(expense.description).trim().replace(/\s+/g, " ")].join("|");
+      groups.set(key, [...(groups.get(key) ?? []), expense]);
+    }
+    const repeated = [...groups.values()].filter((group) => group.length > 1);
+    return repeated.length === 0
+      ? "Sin duplicados"
+      : repeated
+          .map(([first, ...others]) => `${others.length + 1} veces: ${formatDate(first.date)}  ${formatMoney(first.cents)}  ${first.description}`)
+          .join("\n");
+  },
