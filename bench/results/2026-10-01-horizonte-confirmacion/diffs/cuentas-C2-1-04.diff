diff --git a/tests/buscar.test.ts b/tests/buscar.test.ts
new file mode 100644
index 0000000..2b93972
--- /dev/null
+++ b/tests/buscar.test.ts
@@ -0,0 +1,17 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const csv = "fecha,importe,categoria,descripcion\n2026-03-01,3.50,ocio,Café con Ana\n2026-03-02,10,comida,Menú";
+
+it("finds expenses ignoring case and accents, same lines as lista", () => {
+  const io = memoryIo({ "g.csv": csv });
+  const found = run(["buscar", "g.csv", "CAFE"], io);
+  expect(found.code).toBe(0);
+  expect(found.output).toBe(run(["lista", "g.csv"], io).output.split("\n")[0]);
+  expect(run(["buscar", "g.csv", "menu"], io).output).toContain("Menú");
+});
+
+it("says when nothing matches", () => {
+  expect(run(["buscar", "g.csv", "zzz"], memoryIo({ "g.csv": csv })).output).toBe("Sin resultados");
+});
