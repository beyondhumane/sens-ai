+++ b/tests/duplicados.test.ts
@@ -0,0 +1,31 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const norm = (text: string) => text.replace(/ /g, " ");
+const csv = (rows: string[]) => [HEADER, ...rows].join("\n");
+
+it("groups expenses with the same date, amount and description ignoring case, accents and spaces", () => {
+  const io = memoryIo({
+    "g.csv": csv([
+      "2026-03-09,8.75,Ocio,Café con Ana",
+      "2026-03-09,8.75,Comida,  CAFE   con ana ",
+      "2026-03-09,8.75,Ocio,cafe con ana",
+      "2026-03-10,3.00,Ocio,Pan",
+      "2026-03-10,3.00,Ocio,Pan",
+    ]),
+  });
+  const ran = run(["duplicados", "g.csv"], io);
+  expect(ran.code).toBe(0);
+  expect(norm(ran.output)).toBe("3 veces: 09/03/2026  8,75 €  Café con Ana\n2 veces: 10/03/2026  3,00 €  Pan");
+});
+
+it("does not group when date, amount or description differ", () => {
+  const io = memoryIo({ "g.csv": csv(["2026-03-09,8.75,Ocio,Café", "2026-03-10,8.75,Ocio,Café", "2026-03-09,8.70,Ocio,Café", "2026-03-09,8.75,Ocio,Té"]) });
+  expect(run(["duplicados", "g.csv"], io)).toEqual({ code: 0, output: "Sin duplicados" });
+});
+
+it("requires a file", () => {
+  expect(run(["duplicados"], memoryIo({}))).toEqual({ code: 1, output: "Falta el fichero de gastos" });
+});
