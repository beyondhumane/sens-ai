+function rangeArgs(args: string[]): { path: string | undefined; from: string | undefined; to: string | undefined } {
+  const dates: Record<string, string | undefined> = {};
+  const rest: string[] = [];
+  for (let i = 0; i < args.length; i++) {
+    const arg = args[i];
+    if (arg === "--desde" || arg === "--hasta") {
+      const value = args[++i] ?? "";
+      if (!isRealDate(value)) throw new Error(`Fecha no válida: ${value}`);
+      dates[arg] = value;
+    } else {
+      rest.push(arg);
+    }
+  }
+  return { path: rest[0], from: dates["--desde"], to: dates["--hasta"] };
+}
