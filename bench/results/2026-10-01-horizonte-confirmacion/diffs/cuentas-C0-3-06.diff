+function takeMonth(args: string[]): { month: string | undefined; rest: string[] } {
+  const flag = args.indexOf("--mes");
+  if (flag === -1) return { month: undefined, rest: args };
+  const month = args[flag + 1] ?? "";
+  if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(month)) throw new Error(`Mes no válido: ${month}`);
+  return { month, rest: [...args.slice(0, flag), ...args.slice(flag + 2)] };
+}
+
+function inMonth(expenses: Expense[], month: string | undefined): Expense[] {
+  return expenses.filter((expense) => month === undefined || expense.date.startsWith(`${month}-`));
+}
+
+function sumByCategory(expenses: Expense[]): [string, number][] {
+  const byCategory = new Map<string, number>();
+  for (const expense of expenses) {
+    byCategory.set(expense.category, (byCategory.get(expense.category) ?? 0) + expense.cents);
+  }
+  return [...byCategory].sort(
+    ([nameA, centsA], [nameB, centsB]) => centsB - centsA || nameA.localeCompare(nameB, "es"),
+  );
+}
+
+function sumCents(expenses: Expense[]): number {
+  return expenses.reduce((sum, expense) => sum + expense.cents, 0);
+}
+
+const MONTHS = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
