+  avisos: (args, io) => {
+    const month = monthFlag(args);
+    if (month === undefined) throw new Error("Falta --mes");
+    const path = args[1];
+    if (!path || path.startsWith("--")) throw new Error("Falta el fichero de presupuestos");
+    const budgets = parseBudgets(io.read(path));
+    const over = categoryTotals(inMonth(load(args[0], io), month)).flatMap(([category, cents]) => {
+      const budget = budgets.find((candidate) => plain(candidate.category) === plain(category));
+      return budget && cents > budget.cents ? [{ category, excess: cents - budget.cents }] : [];
+    });
+    return over.length === 0
+      ? "Todo en orden"
+      : over
+          .sort((a, b) => b.excess - a.excess)
+          .map(({ category, excess }) => `${category}: te pasas ${formatMoney(excess)}`)
+          .join("\n");
+  },
   categorias: (args, io) => {
     return categoryTotals(load(args[0], io))
       .map(([category, cents]) => `${category}: ${formatMoney(cents)}`)
