     return lines.length === 0 ? "Todo en orden" : lines.join("\n");
   },
+  resumen: (args, io) => {
+    const expenses = load(args[0], io);
+    if (expenses.length === 0) return "Sin gastos";
+    let biggest = expenses[0];
+    let first = expenses[0].date;
+    let last = expenses[0].date;
+    let total = 0;
+    for (const expense of expenses) {
+      if (expense.cents > biggest.cents) biggest = expense;
+      if (expense.date < first) first = expense.date;
+      if (expense.date > last) last = expense.date;
+      total += expense.cents;
+    }
+    return [
+      `Gastos: ${expenses.length}`,
+      `Desde ${formatDate(first)} hasta ${formatDate(last)}`,
+      `Total: ${formatMoney(total)}`,
+      `Mayor: ${formatMoney(biggest.cents)} en ${biggest.description} (${formatDate(biggest.date)})`,
+    ].join("\n");
+  },
   categorias: (args, io) => categoryLines(load(args[0], io)).join("\n"),
   informe: (args, io) => {
     const { rest: afterBudgets, budgetPath } = budgetArgs(args);
