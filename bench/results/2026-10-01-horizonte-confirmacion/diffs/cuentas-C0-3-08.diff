diff --git a/src/csv.ts b/src/csv.ts
index f21bd0a..1bf32a2 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -2,13 +2,52 @@ import type { Expense } from "./expense";
 
 export const HEADER = "fecha,importe,categoria,descripcion";
 
+function parseRecords(text: string): string[][] {
+  const records: string[][] = [];
+  let fields: string[] = [];
+  let field = "";
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const char = text[i];
+    if (quoted) {
+      if (char !== '"') field += char;
+      else if (text[i + 1] === '"') (field += '"'), i++;
+      else quoted = false;
+    } else if (char === '"' && field === "") {
+      quoted = true;
+    } else if (char === ",") {
+      fields.push(field);
+      field = "";
+    } else if (char === "\n" || (char === "\r" && text[i + 1] === "\n")) {
+      if (char === "\r") i++;
+      fields.push(field);
+      records.push(fields);
+      fields = [];
+      field = "";
+    } else {
+      field += char;
+    }
+  }
+  if (quoted) throw new Error("Comillas sin cerrar");
+  fields.push(field);
+  records.push(fields);
+  return records;
+}
+
+export function formatField(value: string): string {
+  return /[",]/.test(value) ?`"${value.replace(/"/g, '""')}"` : value;
+}
+
 export function parseExpenses(text: string): Expense[] {
-  const [header, ...rows] = text.trim().split(/\r?\n/);
+  const [headerFields, ...rows] = parseRecords(text.trim());
+  const header = headerFields.join(",");
   if (header !== HEADER) throw new Error(`Cabecera desconocida: ${header}`);
   return rows
-    .filter((row) => row.trim() !== "")
-    .map((row) => {
-      const [date, amount, category, ...rest] = row.split(",");
-      return { date, cents: Math.round(Number(amount) * 100), category, description: rest.join(",") };
-    });
+    .filter((fields) => fields.some((field) => field.trim() !== ""))
+    .map(([date, amount, category, ...rest]) => ({
+      date,
+      cents: Math.round(Number(amount) * 100),
+      category,
+      description: rest.join(","),
+    }));
 }
