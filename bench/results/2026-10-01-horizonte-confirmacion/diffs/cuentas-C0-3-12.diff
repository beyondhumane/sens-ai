+
+export function parseBudgets(text: string): { category: string; cents: number }[] {
+  const [headerFields, ...rows] = parseRecords(text.trim());
+  const header = headerFields.join(",");
+  if (header !== BUDGET_HEADER) throw new Error(`Cabecera desconocida: ${header}`);
+  return rows
+    .filter((fields) => fields.some((field) => field.trim() !== ""))
+    .map(([category, amount]) => ({ category, cents: Math.round(Number(amount) * 100) }));
+}
