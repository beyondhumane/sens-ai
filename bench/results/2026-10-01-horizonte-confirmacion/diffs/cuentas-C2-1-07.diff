+function dateFlag(args: string[], flag: string): string | undefined {
+  const index = args.indexOf(flag);
+  if (index === -1) return undefined;
+  const date = args[index + 1] ?? "";
+  if (!isValidDate(date)) throw new Error(`Fecha no válida: ${date}`);
+  return date;
+}
+
+function withRange(args: string[]): { path: string | undefined; from: string | undefined; to: string | undefined } {
+  const from = dateFlag(args, "--desde");
+  const to = dateFlag(args, "--hasta");
+  const flags = ["--desde", "--hasta"].map((flag) => args.indexOf(flag)).filter((i) => i !== -1);
+  return { path: args.find((_, i) => !flags.includes(i) && !flags.includes(i - 1)), from, to };
+}
