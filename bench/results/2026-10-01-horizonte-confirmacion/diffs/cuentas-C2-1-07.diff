diff --git a/tests/lista.test.ts b/tests/lista.test.ts
new file mode 100644
index 0000000..4ade882
--- /dev/null
+++ b/tests/lista.test.ts
@@ -0,0 +1,26 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const csv = [HEADER, "2026-02-28,10,comida,a", "2026-03-01,20,comida,b", "2026-03-15,5.5,ocio,c", "2026-03-16,1,ocio,d"].join("\n");
+const lista = (...args: string[]) => run(["lista", ...args], memoryIo({ "g.csv": csv }));
+const descriptions = (output: string) => output.split("\n").map((line) => line.split("  ").pop());
+
+it("lists everything without flags", () => {
+  expect(descriptions(lista("g.csv").output)).toEqual(["a", "b", "c", "d"]);
+});
+
+it("includes both ends of the range", () => {
+  expect(descriptions(lista("g.csv", "--desde", "2026-03-01", "--hasta", "2026-03-15").output)).toEqual(["b", "c"]);
+});
+
+it("accepts --desde or --hasta alone, in any position", () => {
+  expect(descriptions(lista("--desde", "2026-03-15", "g.csv").output)).toEqual(["c", "d"]);
+  expect(descriptions(lista("g.csv", "--hasta", "2026-03-01").output)).toEqual(["a", "b"]);
+});
+
+it("rejects a date that does not exist", () => {
+  expect(lista("g.csv", "--hasta", "2026-03-32")).toEqual({ code: 1, output: "Fecha no válida: 2026-03-32" });
+  expect(lista("g.csv", "--desde", "2026-02-30")).toEqual({ code: 1, output: "Fecha no válida: 2026-02-30" });
+});
