diff --git a/tests/total.test.ts b/tests/total.test.ts
new file mode 100644
index 0000000..0433a3a
--- /dev/null
+++ b/tests/total.test.ts
@@ -0,0 +1,21 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const csv = [HEADER, "2026-02-10,10,comida,a", "2026-03-01,20,comida,b", "2026-03-15,5.5,ocio,c"].join("\n");
+const total = (...args: string[]) => run(["total", ...args], memoryIo({ "g.csv": csv }));
+const clean = (text: string) => text.replace(/\s/g, " ");
+
+it("sums everything without --mes", () => {
+  expect(clean(total("g.csv").output)).toBe("Total: 35,50 €");
+});
+
+it("sums only the given month", () => {
+  expect(clean(total("g.csv", "--mes", "2026-03").output)).toBe("Total: 25,50 €");
+  expect(clean(total("--mes", "2026-02", "g.csv").output)).toBe("Total: 10,00 €");
+});
+
+it("rejects an invalid month", () => {
+  expect(total("g.csv", "--mes", "2026-13")).toEqual({ code: 1, output: "Mes no válido: 2026-13" });
+});
