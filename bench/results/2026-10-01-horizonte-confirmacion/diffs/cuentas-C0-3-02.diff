diff --git a/src/cli.ts b/src/cli.ts
index ff673d0..b178856 100644
--- a/src/cli.ts
+++ b/src/cli.ts
@@ -25,6 +25,16 @@ const commands: Record<string, Command> = {
     load(args[0], io)
       .map((expense) => [formatDate(expense.date), expense.category, formatMoney(expense.cents), expense.description].join("  "))
       .join("\n"),
+  categorias: (args, io) => {
+    const byCategory = new Map<string, number>();
+    for (const expense of load(args[0], io)) {
+      byCategory.set(expense.category, (byCategory.get(expense.category) ?? 0) + expense.cents);
+    }
+    return [...byCategory]
+      .sort(([nameA, centsA], [nameB, centsB]) => centsB - centsA || nameA.localeCompare(nameB, "es"))
+      .map(([name, cents]) => `${name}: ${formatMoney(cents)}`)
+      .join("\n");
+  },
   total: (args, io) => `Total: ${formatMoney(load(args[0], io).reduce((sum, expense) => sum + expense.cents, 0))}`,
 };
 
