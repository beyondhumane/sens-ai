+      const left = budget.cents - cents;
+      const verdict = left >= 0 ? `quedan ${formatMoney(left)}` : `te pasas ${formatMoney(-left)}`;
+      return `  ${category}: ${formatMoney(cents)} de ${formatMoney(budget.cents)} (${verdict})`;
+    };
