+function appendExpenses(path: string, expenses: Expense[], io: Io): void {
+  if (expenses.length === 0) return;
+  const text = io.read(path);
+  io.write(path, `${text}${text.endsWith("\n") ? "" : "\n"}${expenses.map(formatExpense).join("")}`);
+}
+
+// Devuelve undefined para los ingresos; lanza si la línea no se entiende.
+function parseBankRow(row: string, lineNumber: number): Expense | undefined {
+  const invalid = new Error(`Línea ${lineNumber} del banco no válida`);
+  const fields = row.split(";");
+  if (fields.length < 3) throw invalid;
+  const [day, month, year] = fields[0].trim().split("/");
+  const date = `${year}-${month}-${day}`;
+  const description = fields.slice(1, -1).join(";").trim();
+  const amount = fields[fields.length - 1].trim();
+  if (!isValidDate(date) || description === "") throw invalid;
+  let cents: number;
+  try {
+    cents = parseAmount(amount.replace(/^-/, ""));
+  } catch {
+    throw invalid;
+  }
+  return amount.startsWith("-") ? { date, cents, category: "Sin categoría", description } : undefined;
+}
