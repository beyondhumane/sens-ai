+  importar: (args, io) => {
+    const [bankPath, path] = args;
+    if (!bankPath || !path) throw new Error("Uso: importar <fichero-del-banco> <fichero>");
+    const imported: Expense[] = [];
+    io.read(bankPath)
+      .split(/\r?\n/)
+      .forEach((text, index) => {
+        if (index > 0 && text.trim() === "") return;
+        const invalid = () => new Error(`Línea ${index + 1} del banco no válida`);
+        const fields = text.split(";");
+        if (index === 0) {
+          if (text.replace(/^﻿/, "") !== "Fecha;Concepto;Importe") throw invalid();
+          return;
+        }
+        const [day, description, amount] = fields;
+        const date = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(day ?? "");
+        const iso = date ? `${date[3]}-${date[2]}-${date[1]}` : "";
+        if (fields.length !== 3 || !isRealDate(iso) || !description.trim() || !/^[+-]?[\d.,]+$/.test(amount)) {
+          throw invalid();
+        }
+        let cents: number;
+        try {
+          cents = parseCents(amount.replace(/^[+-]/, ""));
+        } catch {
+          throw invalid();
+        }
+        if (amount.startsWith("-")) {
+          imported.push({ date: iso, cents, category: "Sin categoría", description: description.trim() });
+        }
+      });
+    const current = io.read(path);
+    parseExpenses(current);
+    const rows = imported.map((expense) => `${csvRow(expense)}\n`).join("");
+    io.write(path, current.endsWith("\n") ? current + rows : `${current}\n${rows}`);
+    return `Importados ${imported.length} gastos`;
+  },
