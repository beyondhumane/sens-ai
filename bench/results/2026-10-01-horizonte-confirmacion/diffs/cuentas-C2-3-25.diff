+  resumen: (args, io) => {
+    const expenses = load(args[0], io);
+    if (expenses.length === 0) return "Sin gastos";
+    const dates = expenses.map((expense) => expense.date).sort();
+    const biggest = expenses.reduce((best, expense) => (expense.cents > best.cents ? expense : best));
+    return [
+      `Gastos: ${expenses.length}`,
+      `Desde ${formatDate(dates[0])} hasta ${formatDate(dates[dates.length - 1])}`,
+      `Total: ${formatMoney(sumCents(expenses))}`,
+      `Mayor: ${formatMoney(biggest.cents)} en ${biggest.description} (${formatDate(biggest.date)})`,
+    ].join("\n");
+  },
