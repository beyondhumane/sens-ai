diff --git a/src/date.ts b/src/date.ts
index 5140cf5..80b1363 100644
--- a/src/date.ts
+++ b/src/date.ts
@@ -1,4 +1,24 @@
+const MONTHS = [
+  "Enero",
+  "Febrero",
+  "Marzo",
+  "Abril",
+  "Mayo",
+  "Junio",
+  "Julio",
+  "Agosto",
+  "Septiembre",
+  "Octubre",
+  "Noviembre",
+  "Diciembre",
+];
+
 export function formatDate(iso: string): string {
   const [year, month, day] = iso.split("-");
   return `${day}/${month}/${year}`;
 }
+
+export function formatMonth(yearMonth: string): string {
+  const [year, month] = yearMonth.split("-");
+  return `${MONTHS[Number(month) - 1]} de ${year}`;
+}
diff --git a/tests/informe.test.ts b/tests/informe.test.ts
new file mode 100644
index 0000000..d5cb210
--- /dev/null
+++ b/tests/informe.test.ts
@@ -0,0 +1,25 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const csv = [
+  HEADER,
+  "2026-02-10,10,Comida,a",
+  "2026-03-01,20,Comida,b",
+  "2026-03-15,60,Ocio,c",
+  "2026-03-20,24.65,Comida,d",
+].join("\n");
+const informe = (...args: string[]) => run(["informe", ...args], memoryIo({ "g.csv": csv }));
+const clean = (text: string) => text.replace(/[^\S\n]/g, " ");
+
+it("lists the month's categories from most to least, then the total", () => {
+  const { code, output } = informe("g.csv", "--mes", "2026-03");
+  expect(code).toBe(0);
+  expect(clean(output)).toBe("Marzo de 2026\n  Ocio: 60,00 €\n  Comida: 44,65 €\nTotal: 104,65 €");
+});
+
+it("requires a valid month", () => {
+  expect(informe("g.csv")).toEqual({ code: 1, output: "Falta el mes (--mes AAAA-MM)" });
+  expect(informe("g.csv", "--mes", "2026-13")).toEqual({ code: 1, output: "Mes no válido: 2026-13" });
+});
