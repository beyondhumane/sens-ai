@@ -0,0 +1,20 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const csv = [HEADER, "2026-02-28,10.00,ocio,cine", "2026-03-01,12.50,comida,menu", "2026-03-15,7.50,ocio,libro"].join("\n");
+const norm = (text: string) => text.replace(/ /g, " ");
+
+it("sums everything without --mes", () => {
+  expect(norm(run(["total", "g.csv"], memoryIo({ "g.csv": csv })).output)).toBe("Total: 30,00 €");
+});
+
+it("sums only the given month", () => {
+  expect(norm(run(["total", "g.csv", "--mes", "2026-03"], memoryIo({ "g.csv": csv })).output)).toBe("Total: 20,00 €");
+  expect(norm(run(["total", "--mes", "2026-03", "g.csv"], memoryIo({ "g.csv": csv })).output)).toBe("Total: 20,00 €");
+});
+
+it("rejects a month that does not exist", () => {
+  expect(run(["total", "g.csv", "--mes", "2026-13"], memoryIo({ "g.csv": csv }))).toEqual({ code: 1, output: "Mes no válido: 2026-13" });
+});
