+  renombrar: ([path, category = "", renamed = ""], io) => {
+    load(path, io);
+    checkCategory(renamed);
+    const [header, ...rows] = io.read(path as string).trim().split(/\r?\n/);
+    let count = 0;
+    const updated = rows
+      .filter((row) => row.trim() !== "")
+      .map((row) => {
+        const [date, amount, current, ...rest] = row.split(",");
+        if (fold(current) !== fold(category)) return row;
+        count++;
+        return [date, amount, renamed, ...rest].join(",");
+      });
+    io.write(path as string, `${[header, ...updated].join("\n")}\n`);
+    return `Renombrados ${count} gastos`;
+  },
