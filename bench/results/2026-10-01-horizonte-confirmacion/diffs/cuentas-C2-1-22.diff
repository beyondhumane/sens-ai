+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+it("renames the category ignoring case and accents, and saves the file", () => {
+  const io = memoryIo({
+    "g.csv": [HEADER, "2026-03-09,8.75,Ocio,\"Café, con Ana\"", "2026-03-10,5.00,OCIO,Cine", "2026-03-11,3.00,ócio,Té", "2026-03-12,4.00,Comida,Pan"].join("\n"),
+  });
+  expect(run(["renombrar", "g.csv", "ocio", "Ocio y cultura"], io)).toEqual({ code: 0, output: "Renombrados 3 gastos" });
+  expect(io.read("g.csv")).toBe(
+    [HEADER, "2026-03-09,8.75,Ocio y cultura,\"Café, con Ana\"", "2026-03-10,5.00,Ocio y cultura,Cine", "2026-03-11,3.00,Ocio y cultura,Té", "2026-03-12,4.00,Comida,Pan"].join("\n") + "\n",
+  );
+});
+
+it("rejects an invalid new category", () => {
+  const io = memoryIo({ "g.csv": [HEADER, "2026-03-09,8.75,Ocio,Café"].join("\n") });
+  expect(run(["renombrar", "g.csv", "Ocio", "A,B"], io)).toEqual({ code: 1, output: "Categoría no válida: A,B" });
+});
+
+it("requires the file", () => {
+  expect(run(["renombrar"], memoryIo({}))).toEqual({ code: 1, output: "Falta el fichero de gastos" });
+});
