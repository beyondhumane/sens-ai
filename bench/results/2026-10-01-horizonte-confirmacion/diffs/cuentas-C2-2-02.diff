   total: (args, io) => `Total: ${formatMoney(load(args[0], io).reduce((sum, expense) => sum + expense.cents, 0))}`,
+  categorias: (args, io) => {
+    const totals = new Map<string, number>();
+    for (const expense of load(args[0], io)) {
+      totals.set(expense.category, (totals.get(expense.category) ?? 0) + expense.cents);
+    }
+    return [...totals]
+      .sort(([nameA, centsA], [nameB, centsB]) => centsB - centsA || nameA.localeCompare(nameB, "es"))
+      .map(([category, cents]) => `${category}: ${formatMoney(cents)}`)
+      .join("\n");
+  },
 };
 
