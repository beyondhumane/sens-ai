+describe("presupuesto", () => {
+  it("creates the file, then changes a category in place ignoring case and accents", () => {
+    const io = memoryIo({});
+    expect(shown(run(["presupuesto", "p.csv", "Comida", "100"], io).output)).toBe("Presupuesto de Comida: 100,00 € al mes");
+    run(["presupuesto", "p.csv", "Ocio", "50.5"], io);
+    expect(shown(run(["presupuesto", "p.csv", "comída", "120.25"], io).output)).toBe("Presupuesto de comída: 120,25 € al mes");
+    expect(io.files["p.csv"]).toBe("categoria,importe\ncomída,120.25\nOcio,50.50\n");
+  });
+
+  it("rejects bad input without touching the file", () => {
+    const io = memoryIo({ "p.csv": "categoria,importe\nComida,100.00\n" });
+    expect(run(["presupuesto", "p.csv", "Comida", "-3"], io)).toEqual({ code: 1, output: "Importe no válido: -3" });
+    expect(run(["presupuesto", "p.csv", "Comida", "1.234"], io).code).toBe(1);
+    expect(run(["presupuesto", "p.csv", "a,b", "5"], io).code).toBe(1);
+    expect(run(["presupuesto", "p.csv", "Comida"], io).code).toBe(1);
+    expect(io.files["p.csv"]).toBe("categoria,importe\nComida,100.00\n");
+    expect(run(["presupuesto", "g.csv", "x", "5"], memoryIo({ "g.csv": GASTOS })).output).toMatch(/^Cabecera desconocida/);
+  });
