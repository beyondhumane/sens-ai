 export function escapeField(value: string): string {
   return /[",\r\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
 }
+
+export const BUDGET_HEADER = "categoria,importe";
+
+export function parseBudgets(text: string): string[][] {
+  const [header, ...rows] = parseRecords(text.trim());
+  if (header.join(",") !== BUDGET_HEADER) throw new Error(`Cabecera desconocida: ${header.join(",")}`);
+  return rows.filter((row) => row.some((field) => field.trim() !== ""));
+}
