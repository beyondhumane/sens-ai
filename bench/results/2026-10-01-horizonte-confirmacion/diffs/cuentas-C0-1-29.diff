diff --git a/tests/categorias.test.ts b/tests/categorias.test.ts
new file mode 100644
index 0000000..aebaaa1
--- /dev/null
+++ b/tests/categorias.test.ts
@@ -0,0 +1,21 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const csv = `fecha,importe,categoria,descripcion
+2026-03-01,10.00,Ocio,Cine
+2026-03-02,5.00,Casa,Luz
+2026-04-01,99.00,Ocio,Concierto
+`;
+
+const norm = (text: string) => text.replace(/ /g, " ");
+
+it("only counts the given month", () => {
+  const io = memoryIo({ "g.csv": csv });
+  expect(norm(run(["categorias", "g.csv", "--mes", "2026-03"], io).output)).toBe("Ocio: 10,00 €\nCasa: 5,00 €");
+  expect(norm(run(["categorias", "--mes", "2026-04", "g.csv"], io).output)).toBe("Ocio: 99,00 €");
+});
+
+it("rejects an invalid month", () => {
+  expect(run(["categorias", "g.csv", "--mes", "2026-13"], memoryIo({ "g.csv": csv }))).toEqual({ code: 1, output: "Mes no válido: 2026-13" });
+});
