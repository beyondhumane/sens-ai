-  total: (args, io) => `Total: ${formatMoney(load(args[0], io).reduce((sum, expense) => sum + expense.cents, 0))}`,
+  total: (args, io) => {
+    const flag = args.indexOf("--mes");
+    let month: string | undefined;
+    let rest = args;
+    if (flag !== -1) {
+      month = args[flag + 1] ?? "";
+      if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(month)) throw new Error(`Mes no válido: ${month}`);
+      rest = [...args.slice(0, flag), ...args.slice(flag + 2)];
+    }
+    const expenses = load(rest[0], io).filter((expense) => month === undefined || expense.date.startsWith(`${month}-`));
+    return `Total: ${formatMoney(expenses.reduce((sum, expense) => sum + expense.cents, 0))}`;
+  },
 };
 
