+export const BUDGET_HEADER = "categoria,importe";
+
+export function readBudgetRows(text: string): string[] {
+  const [header, ...rows] = text.trim().split(/\r?\n/);
+  if (header !== BUDGET_HEADER) throw new Error(`Cabecera desconocida: ${header}`);
+  return rows.filter((row) => row.trim() !== "");
+}
+
 function unquote(field: string): string {
   return field.length >= 2 && field.startsWith('"') && field.endsWith('"') ? field.slice(1, -1).replaceAll('""', '"') : field;
 }
diff --git a/tests/presupuesto.test.ts b/tests/presupuesto.test.ts
new file mode 100644
index 0000000..7ee9f8b
--- /dev/null
+++ b/tests/presupuesto.test.ts
@@ -0,0 +1,36 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+import { formatMoney } from "../src/money";
+
+const header = "categoria,importe";
+
+it("creates the file when it does not exist and reports the budget", () => {
+  const io = memoryIo({});
+  expect(run(["presupuesto", "p.csv", "Comida", "100"], io)).toEqual({ code: 0, output: `Presupuesto de Comida: ${formatMoney(10000)} al mes` });
+  expect(io.files["p.csv"]).toBe(`${header}\nComida,100.00\n`);
+});
+
+it("appends new categories and changes existing ones in place, ignoring case and accents", () => {
+  const io = memoryIo({ "p.csv": `${header}\nTransporte,40.00\nCafé,10.00\nOcio,20.00\n` });
+  run(["presupuesto", "p.csv", "Comida", "100.5"], io);
+  run(["presupuesto", "p.csv", "CAFE", "12"], io);
+  expect(io.files["p.csv"]).toBe(`${header}\nTransporte,40.00\nCAFE,12.00\nOcio,20.00\nComida,100.50\n`);
+});
+
+it.each([
+  [["Comida", "-3"], "Importe no válido: -3"],
+  [["Comida", "1,5"], "Importe no válido: 1,5"],
+  [["Comida", "0"], "Importe no válido: 0"],
+  [["Co,mida", "5"], "Categoría no válida: Co,mida"],
+])("rejects %j without touching the file", ([category, amount], message) => {
+  const io = memoryIo({});
+  expect(run(["presupuesto", "p.csv", category, amount], io)).toEqual({ code: 1, output: message });
+  expect(io.files).toEqual({});
+});
+
+it("rejects a file with an unknown header", () => {
+  const io = memoryIo({ "p.csv": "otra,cosa\n" });
+  expect(run(["presupuesto", "p.csv", "Comida", "5"], io)).toEqual({ code: 1, output: "Cabecera desconocida: otra,cosa" });
+  expect(io.files["p.csv"]).toBe("otra,cosa\n");
+});
