+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const duplicados = (rows: string[]) => run(["duplicados", "g.csv"], memoryIo({ "g.csv": [HEADER, ...rows].join("\n") }));
+const clean = (text: string) => text.replace(/[^\S\n]/g, " ");
+
+it("groups expenses with same date, amount and description ignoring case, accents and extra spaces", () => {
+  const { code, output } = duplicados([
+    "2026-03-09,8.75,Ocio,Café con Ana",
+    "2026-03-09,8.75,Comida,  CAFE  con   ana ",
+    "2026-03-09,8.75,Ocio,cafe con ana",
+    "2026-03-10,8.75,Ocio,Café con Ana",
+    "2026-03-09,9.00,Ocio,Café con Ana",
+    "2026-03-11,5,Ocio,Cine",
+    "2026-03-11,5,Ocio,Cine",
+  ]);
+  expect(code).toBe(0);
+  expect(clean(output)).toBe("3 veces: 09/03/2026  8,75 €  Café con Ana\n2 veces: 11/03/2026  5,00 €  Cine");
+});
+
+it("says so when nothing repeats", () => {
+  expect(duplicados(["2026-03-09,8.75,Ocio,Café"])).toEqual({ code: 0, output: "Sin duplicados" });
+});
+
+it("requires the file", () => {
+  expect(run(["duplicados"], memoryIo({}))).toEqual({ code: 1, output: "Falta el fichero de gastos" });
+});
