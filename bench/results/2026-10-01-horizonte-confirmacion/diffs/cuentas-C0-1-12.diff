diff --git a/tests/informe.test.ts b/tests/informe.test.ts
index e1a1e56..829fd36 100644
--- a/tests/informe.test.ts
+++ b/tests/informe.test.ts
@@ -32,3 +32,25 @@ it("requires a valid month", () => {
   expect(run(["informe", "g.csv"], io)).toEqual({ code: 1, output: "Falta el mes" });
   expect(run(["informe", "g.csv", "--mes", "2026-13"], io)).toEqual({ code: 1, output: "Mes no válido: 2026-13" });
 });
+
+it("shows what is left or exceeded for budgeted categories, matching ignoring case and accents", () => {
+  const io = memoryIo({ "g.csv": csv, "p.csv": "categoria,importe\nCÓMIDA,100.00\nocio,55.00\nViajes,10.00\n" });
+  const ran = run(["informe", "g.csv", "--presupuestos", "p.csv", "--mes", "2026-03"], io);
+  expect(ran.code).toBe(0);
+  expect(norm(ran.output)).toBe(
+    "Marzo de 2026\n  Ocio: 60,00 € de 55,00 € (te pasas 5,00 €)\n  Comida: 44,65 € de 100,00 € (quedan 55,35 €)\nTotal: 104,65 €",
+  );
+});
+
+it("leaves categories without budget as they are", () => {
+  const io = memoryIo({ "g.csv": csv, "p.csv": "categoria,importe\nComida,100.00\n" });
+  expect(norm(run(["informe", "g.csv", "--mes", "2026-03", "--presupuestos", "p.csv"], io).output)).toBe(
+    "Marzo de 2026\n  Ocio: 60,00 €\n  Comida: 44,65 € de 100,00 € (quedan 55,35 €)\nTotal: 104,65 €",
+  );
+});
+
+it("fails when the budget file is missing or the flag has no value", () => {
+  const io = memoryIo({ "g.csv": csv });
+  expect(run(["informe", "g.csv", "--mes", "2026-03", "--presupuestos", "p.csv"], io)).toEqual({ code: 1, output: "No existe p.csv" });
+  expect(run(["informe", "g.csv", "--mes", "2026-03", "--presupuestos"], io)).toEqual({ code: 1, output: "Falta el fichero de presupuestos" });
+});
