+++ b/tests/importar.test.ts
@@ -0,0 +1,23 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { memoryIo } from "../src/io";
+
+const header = "fecha,importe,categoria,descripcion";
+const target = `${header}\n2026-03-01,3.00,Ocio,Cine\n`;
+const bank = "Fecha;Concepto;Importe\n09/03/2026;Bar Paco;-8,75\n10/03/2026;Nómina;1.850,00\n11/03/2026;Cena, con amigos;-1.200,5\n";
+
+it("appends only the expenses, as positive amounts, without category", () => {
+  const io = memoryIo({ "b.csv": bank, "g.csv": target });
+  expect(run(["importar", "b.csv", "g.csv"], io)).toEqual({ code: 0, output: "Importados 2 gastos" });
+  expect(io.files["g.csv"]).toBe(`${target}2026-03-09,8.75,Sin categoría,Bar Paco\n2026-03-11,1200.50,Sin categoría,"Cena, con amigos"\n`);
+});
+
+it.each([
+  ["Fecha;Concepto;Importe\n09/03/2026;Bar;-1,00\n31/02/2026;X;-2,00\n", "Línea 3 del banco no válida"],
+  ["Fecha;Concepto;Importe\n09/03/2026;Bar;abc\n", "Línea 2 del banco no válida"],
+  ["Fecha;Concepto;Importe\n09/03/2026;Bar\n", "Línea 2 del banco no válida"],
+])("imports nothing when a line is invalid", (content, message) => {
+  const io = memoryIo({ "b.csv": content, "g.csv": target });
+  expect(run(["importar", "b.csv", "g.csv"], io)).toEqual({ code: 1, output: message });
+  expect(io.files["g.csv"]).toBe(target);
+});
