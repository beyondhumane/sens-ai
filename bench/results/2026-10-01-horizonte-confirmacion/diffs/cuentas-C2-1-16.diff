+  importar: ([bankPath, path], io) => {
+    if (!bankPath) throw new Error("Falta el fichero del banco");
+    load(path, io);
+    const [header, ...lines] = io.read(bankPath).replace(/^﻿/, "").trimEnd().split(/\r?\n/);
+    if (header !== "Fecha;Concepto;Importe") throw new Error("Línea 1 del banco no válida");
+    const rows: string[] = [];
+    lines.forEach((line, i) => {
+      if (line.trim() === "") return;
+      const invalid = new Error(`Línea ${i + 2} del banco no válida`);
+      const fields = line.split(";");
+      if (fields.length !== 3) throw invalid;
+      const [bankDate, concept, amount] = fields;
+      const [day, month, year] = bankDate.split("/");
+      const date = `${year}-${month}-${day}`;
+      const negative = amount.startsWith("-");
+      let cents: number;
+      try {
+        cents = parseCents(negative ? amount.slice(1) : amount);
+      } catch {
+        throw invalid;
+      }
+      if (!/^\d{2}\/\d{2}\/\d{4}$/.test(bankDate) || !isValidDate(date) || concept.trim() === "") throw invalid;
+      if (negative) rows.push([date, (cents / 100).toFixed(2), "Sin categoría", quoteIfNeeded(concept.trim())].join(","));
+    });
+    if (rows.length > 0) {
+      const text = io.read(path as string);
+      io.write(path as string, `${text}${text.endsWith("\n") ? "" : "\n"}${rows.join("\n")}\n`);
+    }
+    return `Importados ${rows.length} gastos`;
+  },
