+function parseAmount(amount: string): number {
+  let plain = amount;
+  if (amount.includes(",")) {
+    if (!/^(\d{1,3}(\.\d{3})+|\d+),\d{1,2}$/.test(amount)) throw new Error(`Importe no válido: ${amount}`);
+    plain = amount.replace(/\./g, "").replace(",", ".");
+  } else if (!/^\d+(\.\d{1,2})?$/.test(amount)) {
+    throw new Error(`Importe no válido: ${amount}`);
+  }
+  if (Number(plain) <= 0) throw new Error(`Importe no válido: ${amount}`);
+  return Math.round(Number(plain) * 100);
 }
 
