diff --git a/tests/renombrar.test.ts b/tests/renombrar.test.ts
new file mode 100644
index 0000000..98a52e5
--- /dev/null
+++ b/tests/renombrar.test.ts
@@ -0,0 +1,22 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const csv = [HEADER, "2026-03-01,20.00,Comida,menu", "2026-03-02,50.00,Ocio,teatro", "2026-03-03,34.65,cómida,\"cena, tarde\""].join("\n");
+
+it("renames the category ignoring case and accents and saves the file", () => {
+  const io = memoryIo({ "g.csv": csv });
+  expect(run(["renombrar", "g.csv", "COMIDA", "Alimentación"], io)).toEqual({ code: 0, output: "Renombrados 2 gastos" });
+  expect(io.files["g.csv"]).toBe(
+    [HEADER, "2026-03-01,20.00,Alimentación,menu", "2026-03-02,50.00,Ocio,teatro", "2026-03-03,34.65,Alimentación,\"cena, tarde\""].join("\n") + "\n",
+  );
+});
+
+it("leaves the file alone when nothing matches or the new name is invalid", () => {
+  const io = memoryIo({ "g.csv": csv });
+  expect(run(["renombrar", "g.csv", "Viajes", "Ocio"], io)).toEqual({ code: 0, output: "Renombrados 0 gastos" });
+  expect(run(["renombrar", "g.csv", "Ocio", "a,b"], io)).toEqual({ code: 1, output: "Categoría no válida: a,b" });
+  expect(run(["renombrar", "g.csv", "Ocio"], io)).toEqual({ code: 1, output: "Falta la categoría" });
+  expect(io.files["g.csv"]).toBe(csv);
+});
