+++ b/src/csv.ts
@@ -9,6 +9,14 @@ export function parseExpenses(text: string): Expense[] {
     .filter((row) => row.trim() !== "")
     .map((row) => {
       const [date, amount, category, ...rest] = row.split(",");
-      return { date, cents: Math.round(Number(amount) * 100), category, description: rest.join(",") };
+      return { date, cents: Math.round(Number(amount) * 100), category, description: unquote(rest.join(",")) };
     });
 }
+
+function unquote(field: string): string {
+  return field.length >= 2 && field.startsWith('"') && field.endsWith('"') ? field.slice(1, -1).replaceAll('""', '"') : field;
+}
+
+export function quoteIfNeeded(field: string): string {
+  return /[,"]/.test(field) ? `"${field.replaceAll('"', '""')}"` : field;
+}
