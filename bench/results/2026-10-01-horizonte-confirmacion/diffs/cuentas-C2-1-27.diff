index 0000000..2920c87
--- /dev/null
+++ b/tests/comparar.test.ts
@@ -0,0 +1,44 @@
+import { expect, it } from "vitest";
+import { run } from "../src/cli";
+import { HEADER } from "../src/csv";
+import { memoryIo } from "../src/io";
+
+const comparar = (rows: string[], ...months: string[]) =>
+  run(["comparar", "g.csv", ...months], memoryIo({ "g.csv": [HEADER, ...rows].join("\n") }));
+const clean = (text: string) => text.replace(/[^\S\n]/g, " ");
+
+it("compares each category between two months, signed, in alphabetical order", () => {
+  const { code, output } = comparar(
+    [
+      "2026-02-03,40,Comida,Super",
+      "2026-03-04,44.65,Comida,Super",
+      "2026-02-10,90,Ocio,Cine",
+      "2026-03-11,60,Ocio,Teatro",
+      "2026-03-12,10,Árboles,Planta",
+      "2026-02-12,5,Casa,Clavos",
+      "2026-03-12,5,Casa,Tornillos",
+      "2026-04-01,99,Otros,Fuera",
+    ],
+    "2026-02",
+    "2026-03",
+  );
+  expect(code).toBe(0);
+  expect(clean(output)).toBe(
+    [
+      "Árboles: 0,00 € → 10,00 € (+10,00 €)",
+      "Casa: 5,00 € → 5,00 € (+0,00 €)",
+      "Comida: 40,00 € → 44,65 € (+4,65 €)",
+      "Ocio: 90,00 € → 60,00 € (-30,00 €)",
+    ].join("\n"),
+  );
+});
+
+it("says so when neither month has expenses", () => {
+  expect(comparar(["2026-04-01,5,Casa,Clavos"], "2026-02", "2026-03")).toEqual({ code: 0, output: "Sin gastos" });
+});
+
+it("validates the months and the file", () => {
+  expect(comparar([], "2026-02", "2026-13")).toEqual({ code: 1, output: "Mes no válido: 2026-13" });
+  expect(comparar([], "2026-02")).toEqual({ code: 1, output: "Mes no válido: " });
+  expect(run(["comparar"], memoryIo({}))).toEqual({ code: 1, output: "Mes no válido: " });
+});
