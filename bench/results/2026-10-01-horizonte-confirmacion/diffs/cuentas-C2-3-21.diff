+  avisos: (args, io) => {
+    const { month, positional } = parseMonthFlag(args);
+    if (month === undefined) throw new Error("Falta el mes");
+    if (!positional[1]) throw new Error("Falta el fichero de presupuestos");
+    const expenses = load(positional[0], io).filter((expense) => expense.date.startsWith(`${month}-`));
+    const budgets = parseBudgets(io.read(positional[1]));
+    const over = categoryTotals(expenses)
+      .map(([category, cents]) => ({
+        category,
+        excess: cents - (budgets.find((row) => plain(row.category) === plain(category))?.cents ?? Infinity),
+      }))
+      .filter(({ excess }) => excess > 0)
+      .sort((a, b) => b.excess - a.excess || a.category.localeCompare(b.category, "es"));
+    return over.length === 0 ? "Todo en orden" : over.map(({ category, excess }) => `${category}: te pasas ${formatMoney(excess)}`).join("\n");
+  },
