diff --git a/src/date.ts b/src/date.ts
index b2a0568..7b727e9 100644
--- a/src/date.ts
+++ b/src/date.ts
@@ -1,5 +1,12 @@
 const dates = new Intl.DateTimeFormat("es-ES", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" });
 
+const months = new Intl.DateTimeFormat("es-ES", { month: "long", year: "numeric", timeZone: "UTC" });
+
+export function formatMonth(month: string): string {
+  const text = months.format(new Date(`${month}-01`));
+  return text.charAt(0).toUpperCase() + text.slice(1);
+}
+
 export function formatDate(iso: string): string {
   return dates.format(new Date(iso));
 }
