+  informe: (rawArgs, io) => {
+    const flag = rawArgs.indexOf("--presupuestos");
+    const budgetPath = flag === -1 ? undefined : rawArgs[flag + 1];
+    if (flag !== -1 && !budgetPath) throw new Error("Falta el fichero de presupuestos");
+    const args = rawArgs.filter((_, i) => i !== flag && i !== flag + 1 || flag === -1);
     const { path, month } = withMonth(args);
     if (month === undefined) throw new Error("Falta el mes (--mes AAAA-MM)");
     const expenses = inMonth(load(path, io), month);
-    const lines = [...sumByCategory(expenses)].map(([category, cents]) => `  ${category}: ${formatMoney(cents)}`);
+    const budgets = new Map(
+      budgetPath === undefined ? [] : readBudgetRows(io.read(budgetPath)).map((row) => {
+        const [name, amount] = row.split(",");
+        return [fold(name), Math.round(Number(amount) * 100)] as const;
+      }),
+    );
+    const lines = [...sumByCategory(expenses)].map(([category, cents]) => {
+      const budget = budgets.get(fold(category));
+      const base = `  ${category}: ${formatMoney(cents)}`;
+      if (budget === undefined) return base;
+      const diff = budget - cents;
+      return `${base} de ${formatMoney(budget)} (${diff >= 0 ? `quedan ${formatMoney(diff)}` : `te pasas ${formatMoney(-diff)}`})`;
+    });
     const total = expenses.reduce((sum, expense) => sum + expense.cents, 0);
     return [formatMonth(month), ...lines, `Total: ${formatMoney(total)}`].join("\n");
   },
