diff --git a/src/dates.ts b/src/dates.ts
index 5140cf5..7585015 100644
--- a/src/dates.ts
+++ b/src/dates.ts
@@ -2,3 +2,12 @@ export function formatDate(iso: string): string {
   const [year, month, day] = iso.split("-");
   return `${day}/${month}/${year}`;
 }
+
+export function parseMonth(text: string): string {
+  if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(text)) throw new Error(`Mes no válido: ${text}`);
+  return text;
+}
+
+export function monthOf(iso: string): string {
+  return iso.slice(0, 7);
+}
diff --git a/src/options.ts b/src/options.ts
new file mode 100644
index 0000000..999eff4
--- /dev/null
+++ b/src/options.ts
@@ -0,0 +1,22 @@
+export interface Options {
+  positional: string[];
+  flags: Map<string, string>;
+}
+
+export function parseOptions(args: string[], allowed: string[]): Options {
+  const positional: string[] = [];
+  const flags = new Map<string, string>();
+  for (let at = 0; at < args.length; at++) {
+    const arg = args[at];
+    if (!arg.startsWith("--")) {
+      positional.push(arg);
+      continue;
+    }
+    const name = arg.slice(2);
+    if (!allowed.includes(name)) throw new Error(`Opción desconocida: ${arg}`);
+    const value = args[++at];
+    if (value === undefined) throw new Error(`Falta el valor de ${arg}`);
+    flags.set(name, value);
+  }
+  return { positional, flags };
+}
