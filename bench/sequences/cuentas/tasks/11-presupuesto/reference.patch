+import { quoted, rows, splitFields } from "./csv";
+import { amountInFile } from "./money";
+import { plain } from "./text";
+
+export const BUDGET_HEADER = "categoria,importe";
+
+export interface Budget {
+  category: string;
+  cents: number;
+}
+
+export function parseBudgets(text: string): Budget[] {
+  return rows(text, BUDGET_HEADER).map((row) => {
+    const [category, amount] = splitFields(row);
+    return { category, cents: Math.round(Number(amount) * 100) };
+  });
+}
+
+export function formatBudgets(budgets: Budget[]): string {
+  return [BUDGET_HEADER, ...budgets.map((budget) => `${quoted(budget.category)},${amountInFile(budget.cents)}`)].join("\n") + "\n";
+}
+
+export function budgetFor(budgets: Budget[], category: string): Budget | undefined {
+  return budgets.find((budget) => plain(budget.category) === plain(category));
+}
+
+export function withBudget(budgets: Budget[], changed: Budget): Budget[] {
+  const before = budgetFor(budgets, changed.category);
+  return before ? budgets.map((budget) => (budget === before ? changed : budget)) : [...budgets, changed];
+}
