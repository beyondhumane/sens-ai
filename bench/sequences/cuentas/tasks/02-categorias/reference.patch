@@ -0,0 +1,18 @@
+import type { Expense } from "./expense";
+
+export function sum(expenses: Expense[]): number {
+  return expenses.reduce((total, expense) => total + expense.cents, 0);
+}
+
+export function totalsBy(expenses: Expense[], key: (expense: Expense) => string): Map<string, number> {
+  const totals = new Map<string, number>();
+  for (const expense of expenses) {
+    const name = key(expense);
+    totals.set(name, (totals.get(name) ?? 0) + expense.cents);
+  }
+  return totals;
+}
+
+export function biggestFirst(totals: Map<string, number>): [string, number][] {
+  return [...totals].sort(([one, a], [other, b]) => b - a || one.localeCompare(other));
+}
