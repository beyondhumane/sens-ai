+
+export function parseAmount(text: string): number {
+  const cents = /^\d+(\.\d{1,2})?$/.test(text) ? Math.round(Number(text) * 100) : 0;
+  if (cents <= 0) throw new Error(`Importe no válido: ${text}`);
+  return cents;
+}
+
+export function amountInFile(cents: number): string {
+  return (cents / 100).toFixed(2);
+}
