 export const HEADER = "fecha,importe,categoria,descripcion";
 
+export function splitFields(row: string, separator = ","): string[] {
+  const fields: string[] = [];
+  let field = "";
+  let inside = false;
+  for (let at = 0; at < row.length; at++) {
+    const letter = row[at];
+    if (inside && letter === '"' && row[at + 1] === '"') {
+      field += '"';
+      at++;
+    } else if (letter === '"') {
+      inside = !inside;
+    } else if (letter === separator && !inside) {
+      fields.push(field);
+      field = "";
+    } else {
+      field += letter;
+    }
+  }
+  fields.push(field);
+  return fields;
+}
+
+export function quoted(field: string, separator = ","): string {
+  return field.includes(separator) || field.includes('"') ? `"${field.replaceAll('"', '""')}"` : field;
+}
+
+export function rows(text: string, header: string): string[] {
+  const [first, ...rest] = text.trim().split(/\r?\n/);
+  if (first !== header) throw new Error(`Cabecera desconocida: ${first}`);
+  return rest.filter((row) => row.trim() !== "");
+}
