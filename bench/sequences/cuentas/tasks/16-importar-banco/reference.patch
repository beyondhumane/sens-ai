+export function parseSpanishDate(text: string): string {
+  const parts = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(text);
+  if (!parts) throw new Error(`Fecha no válida: ${text}`);
+  return parseDay(`${parts[3]}-${parts[2]}-${parts[1]}`);
+}
