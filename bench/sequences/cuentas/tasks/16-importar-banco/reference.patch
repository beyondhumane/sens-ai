+import { rows, splitFields } from "./csv";
+import { parseSpanishDate } from "./dates";
+import type { Expense } from "./expense";
+import { parseAmount } from "./money";
+
+export const BANK_HEADER = "Fecha;Concepto;Importe";
+
+export function bankExpenses(text: string): Expense[] {
+  return rows(text, BANK_HEADER).flatMap((row, at) => {
+    const [date, concept, amount] = splitFields(row, ";");
+    try {
+      const day = parseSpanishDate(date);
+      const cents = parseAmount(amount.replace(/^-/, ""));
+      return amount.startsWith("-") ? [{ date: day, cents, category: "Sin categoría", description: concept }] : [];
+    } catch {
+      throw new Error(`Línea ${at + 2} del banco no válida`);
+    }
+  });
+}
