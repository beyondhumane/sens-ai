+function decimal(text: string): string | undefined {
+  if (/^(\d{1,3}(\.\d{3})*|\d+),\d{1,2}$/.test(text)) return text.replaceAll(".", "").replace(",", ".");
+  if (/^\d+(\.\d{1,2})?$/.test(text)) return text;
+  return undefined;
+}
