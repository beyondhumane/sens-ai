---
import Icon from "../components/Icon.astro";
import { numberOf } from "../content/chapters";
import { siteIcons } from "../content/icons";
import type { Release } from "../content/release";
import data from "../data/release.json";
import Answer from "../product/Answer.astro";
import Changes from "../product/Changes.astro";
import Composer from "../product/Composer.astro";
import Crop from "../product/Crop.astro";
import Request from "../product/Request.astro";
import Run from "../product/Run.astro";
import { home } from "../i18n/home";
import type { Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = home(locale);
const chapters = t.chapters.map((chapter, at) => ({ ...chapter, n: at + 1 }));
const release = data as Release;
const minor = release.version?.split(".").slice(0, 2).join(".");
const animated = new Set([2, 3, 4, 5]);
---

<section class="demo" id="how-it-works" aria-labelledby="demo-title">
  <div class="wrap">
    <div class="demo-copy">
      <div class="demo-intro">
        <p class="label">{t.demoLabel}</p>
        <h2 class="demo-title" id="demo-title">{t.demoTitle}</h2>
        <p class="demo-lead">{t.demoLead}</p>
        {minor && <p class="mono stage-tag">{t.replayTag(minor)}</p>}
      </div>
      <nav class="chapter-index" aria-label={t.chaptersLabel} data-index>
        {
          chapters.map((chapter) => (
            <a class="mono" href={`#chapter-${chapter.n}`} data-to={chapter.n} aria-label={t.chapterLabel(numberOf(chapter.n), chapter.title)}>
              {numberOf(chapter.n)}
            </a>
          ))
        }
      </nav>
      <ol class="chapters" data-chapters>
        {
          chapters.map((chapter) => (
            <li class="chapter" id={`chapter-${chapter.n}`} data-chapter={chapter.n}>
              <div class="chapter-copy">
                <p class="chapter-num mono">{numberOf(chapter.n)}</p>
                <h3>{chapter.title}</h3>
                <p class="chapter-text">{chapter.text}</p>
                <p class="sr-only">{chapter.replay}</p>
              </div>
              <div class="card" data-card={chapter.n}>
                <div aria-hidden="true" inert>
                  {chapter.n === 1 && (
                    <Crop id="card-1">
                      <Request />
                      <Composer />
                    </Crop>
                  )}
                  {chapter.n === 2 && (
                    <Crop id="card-2">
                      <Run open />
                    </Crop>
                  )}
                  {chapter.n === 3 && (
                    <Crop id="card-3">
                      <Run open openStep="run-before" only={["thought-tests", "run-before", "thought-prop"]} />
                    </Crop>
                  )}
                  {chapter.n === 4 && (
                    <Crop id="card-4">
                      <Run open openStep="sens-stop" only={["thought-prop", "sens-stop", "thought-reuse"]} />
                    </Crop>
                  )}
                  {chapter.n === 5 && (
                    <Crop id="card-5">
                      <Run open only={["thought-reuse", "edit-header", "edit-test"]} />
                      <div class="code">
                        <Changes />
                      </div>
                    </Crop>
                  )}
                  {chapter.n === 6 && (
                    <Crop id="card-6">
                      <Run />
                      <Answer />
                    </Crop>
                  )}
                </div>
                {animated.has(chapter.n) && (
                  <button class="replay" type="button" data-replay aria-label={t.replayChapter(numberOf(chapter.n))}>
                    <Icon paths={siteIcons.replay} size={18} />
                    <span aria-hidden="true">{t.replay}</span>
                  </button>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
