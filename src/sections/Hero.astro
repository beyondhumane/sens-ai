---
import Download from "../components/Download.astro";
import Icon from "../components/Icon.astro";
import wordmark from "../brand/wordmark.svg?raw";
import { siteIcons } from "../content/icons";
import { links } from "../content/site";
import Crop from "../product/Crop.astro";
import Window from "../product/Window.astro";
import Request from "../product/Request.astro";
import Run from "../product/Run.astro";
import Answer from "../product/Answer.astro";
import Pieces from "../components/Pieces.astro";
import { home } from "../i18n/home";
import { pathFor, type Locale } from "../i18n/locales";
import { site } from "../i18n/site";
import headline from "../data/headline.json";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = home(locale);
const common = site(locale);
const lines = t.lines;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <span class="hero-field" data-field aria-hidden="true"></span>
  <div class="hero-shot" aria-hidden="true" inert>
    <Window id="hero" />
  </div>
  <span class="scan" aria-hidden="true"></span>
  <div class="wrap">
    <div class="hero-copy">
      <h1 class="display" id="hero-title" style={`--line-em: ${headline[locale].line}; --word-em: ${headline[locale].word}`}>
        {
          lines.map((words, line) => (
            <span class="line" style={`--line: ${line}`}>
              {words.map((word, at) => (
                <Fragment>
                  <span class="word" style={`--word: ${line * 2 + at}`}>
                    <span class="in">{word}</span>
                  </span>
                  {at === 0 ? " " : ""}
                </Fragment>
              ))}
            </span>
          ))
        }
      </h1>
      <p class="lead" data-settle>{t.lead}</p>
      <p class="hero-proof" data-settle><Pieces pieces={t.proof} href={pathFor(locale, "/#engine")} /></p>
      <p class="label hero-label" data-settle>{common.facts}</p>
      <div class="actions" data-settle>
        <Download label={common.downloadForWindows} locale={locale} />
        <a class="link" href={links.repo}>{t.viewOnGithub} <Icon paths={siteIcons.arrow} size={18} /></a>
      </div>
      <p class="only-phone-note">{t.phoneNote}</p>
    </div>
  </div>
  <p class="sr-only">{t.windowDescription}</p>
  <div class="hero-crop" aria-hidden="true" inert>
    <Crop id="hero" bar>
      <Request />
      <Run />
      <Answer />
    </Crop>
  </div>
  <div class="wordmark" aria-hidden="true" set:html={wordmark} />
</section>
